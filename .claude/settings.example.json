{
  "permissions": {
    "allow": [
      "Bash(npm run gate:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npm run db:migrate:*)",
      "Bash(npm run db:snapshot:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx prisma validate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(npx prisma migrate dev:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(prisma migrate dev:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-command-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the command against the repository's rules"
          }
        ]
      }
    ]
  }
}
