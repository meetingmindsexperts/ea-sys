// ==================== AUDIT & LOGGING ====================

/// Outcome of a single sign-in attempt.
///
/// FAILED_UNKNOWN_EMAIL is kept DISTINCT from FAILED_PASSWORD deliberately:
/// together they separate "someone is guessing this person's password" (the
/// account is real and under attack) from "someone is spraying addresses at
/// us" (reconnaissance). Collapsing them into one FAILED value would lose
/// exactly the distinction an admin needs to decide whether to act.
enum LoginOutcome {
  SUCCESS
  FAILED_PASSWORD
  FAILED_UNKNOWN_EMAIL
  BLOCKED_RATE_LIMIT
  /// Correct password, but the account is deactivated. Distinct from
  /// FAILED_PASSWORD on purpose: an admin reading a run of failures needs to
  /// tell "they cannot get in because we switched them off" apart from "someone
  /// is guessing passwords".
  BLOCKED_DEACTIVATED
}

/// Which door the sign-in came through. A hint for the admin view, not a
/// security boundary — the web values are supplied by the login page.
enum LoginSurface {
  DASHBOARD
  EVENT_PAGE
  MOBILE
}

/// One row per sign-in ATTEMPT — successful or not.
///
/// WHY ITS OWN TABLE RATHER THAN AuditLog ROWS
/// -------------------------------------------
/// AuditLog has the right columns (userId / ipAddress / userAgent / createdAt)
/// and using it would have been free. Three things ruled it out:
///
///  1. Failed attempts are an UNAUTHENTICATED, attacker-controllable write
///     path. AuditLog is the business audit trail that `GET /api/activity`
///     reads; letting an anonymous brute-forcer append thousands of rows to it
///     would drown the record of what staff actually did.
///  2. AuditLog has no prune job and its rows survive a subject-erasure
///     request. Sign-in IP + geo is personal data that needs a bounded
///     retention window — hence the `login-event-prune` worker job.
///  3. `entityType`/`entityId` are required on AuditLog and mean nothing for a
///     failed attempt on an address that resolves to no user at all.
///
/// `userId`/`organizationId` are BOTH nullable, and null carries meaning: a
/// FAILED_UNKNOWN_EMAIL attempt has no user and therefore no org, so it is
/// invisible in the org-scoped admin view by construction. That is intended —
/// address spray is noise; an attack on a real account in your org resolves to
/// a user and so IS visible.
///
/// Geo columns are populated LAZILY (see src/lib/login-geo.ts): the login path
/// never makes an outbound call, because a slow or unreachable geo provider
/// would sit between the password check and session creation and make signing
/// in feel broken. They stay null until an admin opens the view, and null in
/// `geoResolvedAt` means "not looked up yet", not "no location".
/// One measured hit on a public page. A pageview is a hit whose `name` is
/// "pageview"; conversions are hits with a different name and optionally a
/// `value`. See docs/ANALYTICS_PLAN.md.
///
/// WHAT IS DELIBERATELY ABSENT, and must stay absent:
///   - There is NO ipAddress column. Not nullable, not optional. Absent. The IP
///     is consumed at the request boundary to derive visitorHash, deviceType,
///     browser and os, and then discarded. A column that does not exist cannot
///     be filled in by a well-meaning future change, which is the whole point.
///   - There is no userId. Linking a hit to an account would make this personal
///     data and collapse the argument that no consent banner is needed.
///   - `path` never carries a query string. Enforced upstream in
///     src/analytics/core/path-policy.ts and asserted by test.
///
/// No FK relations, on purpose. This is the highest-write table in the system,
/// and a hit that outlives its event is still a valid historical fact; a
/// cascade would silently delete traffic history when an event is removed.
/// organizationId is the denormalized tenancy scalar (the LoginEvent
/// convention), stamped at write from the resolved site.
model AnalyticsEvent {
  id             String   @id @default(cuid())
  organizationId String?
  /// Which conference's public pages. Null only for a site we could not resolve.
  eventId        String?
  /// Opaque tenant/site key. In EA-SYS this is the event slug.
  siteId         String
  /// "pageview", or a conversion name such as "register_submitted".
  name           String
  /// Pathname only, allow-listed, query stripped.
  path           String
  /// The matched pattern, e.g. "/e/:slug/register/:category", so one page can
  /// be compared across events.
  routePattern   String
  /// Rotating-salt identity. Unlinkable across days by construction.
  visitorHash    String
  /// Derived 30-minute window. Nothing is stored client-side.
  sessionHash    String
  /// Host only, never the full referrer URL.
  referrerHost   String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  deviceType     String?
  browser        String?
  os             String?
  /// ISO 3166-1 alpha-2. Phase 2 of the plan; always null in v1.
  country        String?
  durationMs     Int?
  /// 0-100.
  scrollDepth    Int?
  /// Conversion value, e.g. a ticket price.
  value          Decimal? @db.Decimal(10, 2)
  /// When the hit happened, not when the buffer flushed.
  createdAt      DateTime @default(now())

  /// "How did this site do over this window?" — the main chart.
  @@index([siteId, createdAt])
  /// "How many reached each funnel step for this event?"
  @@index([eventId, name, createdAt])
  /// Tenancy scoping.
  @@index([organizationId])
  /// Unique-visitor and session rollups.
  @@index([visitorHash, createdAt])
  /// Retention sweep (prune by age, across all orgs).
  @@index([createdAt])
}

model LoginEvent {
  id             String       @id @default(cuid())
  userId         String?
  organizationId String?
  /// The address that was ATTEMPTED, normalized to lowercase. Present even
  /// when no user matched — that is the whole point of recording it.
  email          String
  outcome        LoginOutcome
  surface        LoginSurface @default(DASHBOARD)
  ipAddress      String?
  userAgent      String?      @db.Text

  // ── Lazily-resolved location (null until first viewed) ──
  geoCity       String?
  geoCountry    String?
  geoResolvedAt DateTime?

  createdAt DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // The admin view's default query: newest-first within one org.
  @@index([organizationId, createdAt])
  // "Show me this person's sign-in history."
  @@index([userId, createdAt])
  // "Who has been trying this address?" — works for unknown emails too, which
  // have no userId to index on.
  @@index([email, createdAt])
  // "What else has this address been doing?" — the brute-force pivot.
  @@index([ipAddress, createdAt])
  // Retention sweep (prune by age, across all orgs).
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  eventId        String?
  userId         String?
  // Denormalized tenant key (Domain #19 sweep, Aug 3 2026). Deliberately a
  // bare scalar with NO FK (sweep convention): the audit trail must survive
  // org deletion with its attribution intact — an FK SetNull would erase
  // exactly the column RLS scopes on (the same failure mode eventId already
  // exhibits: deleting an Event nulls eventId on its audit rows). Stamped
  // centrally by the withAuditOrgStamp client extension in src/lib/db.ts
  // (explicit-in-data → ambient tenant lane → eventId 1-hop), plus explicit
  // stamps at the org-scoped writers that have neither. Nullable: org-null
  // actors (registrant/reviewer auth flows) legitimately produce
  // unattributable rows — see prisma/rls/auditlog.sql for the NULL policy.
  organizationId String?
  action         String
  entityType     String
  entityId       String
  changes        Json     @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  // Analytics time-series: "all CHECK_IN / BADGE_PRINTED actions for event E,
  // bucketed by time" — without this the histogram queries full-scan.
  @@index([eventId, action, createdAt])
  // Serves the global /api/activity feed's org-scoped, createdAt-desc query.
  @@index([organizationId, createdAt])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String // error, warn, info, debug
  module    String // api, auth, database, events, middleware
  message   String   @db.Text
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([level])
  @@index([module])
}

// ==================== HELP-ASSISTANT QUERY CAPTURE ====================

/// One row per completed help-assistant answer — the user's question plus the
/// assistant's reply, with a snapshot of who asked. Who/org are stored as plain
/// SCALARS (no FK), matching the tenancy convention: a deleted user's history
/// survives and we don't have to carry a User/Organization back-relation.
///
/// Written FIRE-AND-FORGET from POST /api/help-chat after the SSE stream
/// completes, so a persistence failure can never break the chat. Read only via
/// SUPER_ADMIN /admin/help-queries.
///
/// This deliberately reverses the route's original "never persist question
/// bodies" stance (owner decision, 2026-07-29): the questions ARE the product
/// signal. Because questions can reference real attendee data, the ONLY read
/// surface is SUPER_ADMIN — never exposed to any other role or org-scoped view.
model HelpChatQuery {
  id               String   @id @default(cuid())
  userId           String?
  userEmail        String?
  userName         String?
  role             String?
  organizationId   String?
  organizationName String?
  question         String   @db.Text
  answer           String   @db.Text
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

