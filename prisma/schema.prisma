generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== CORE ENTITIES ====================

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logo           String?
  primaryColor   String?  @map("primary_color")
  settings       Json     @default("{}")
  // Billing/Company info (for invoice "From" section)
  companyName    String?
  companyAddress String?  @db.Text
  companyCity    String?
  companyState   String?
  companyZipCode String?
  companyCountry String?
  companyPhone   String?
  companyEmail   String?
  taxId          String?
  invoicePrefix  String?  @default("INV")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users           User[]
  events          Event[]
  contacts        Contact[]
  apiKeys         ApiKey[]
  mediaFiles      MediaFile[]
  invoices        Invoice[]
  scheduledEmails ScheduledEmail[]
  emailLogs       EmailLog[]
  billingAccounts BillingAccount[]
  tenantDomains   TenantDomain[]

  // CRM module — see docs/CRM_MODULE_PLAN.md
  crmCompanies       CrmCompany[]
  crmContacts        CrmContact[]
  crmPipelineStages  CrmPipelineStage[]
  crmDealTypes       CrmDealType[]
  crmDeals           CrmDeal[]
  crmTasks           CrmTask[]
  employees          Employee[]
  leaveCodes         LeaveCode[]
  attendanceEntries  AttendanceEntry[]
  leaveGrants        LeaveGrant[]
  publicHolidays     PublicHoliday[]
  attendanceRules    AttendanceRule[]
  crmNotes           CrmNote[]
  crmActivities      CrmActivity[]
  crmNotifications   CrmNotification[]
  crmDealDocuments   CrmDealDocument[]
  crmEmailTemplates  CrmEmailTemplate[]
  crmProducts        CrmProduct[]
  crmEmailThreads    CrmEmailThread[]
  crmEmailSendClaims CrmEmailSendClaim[]
  loginEvents        LoginEvent[]
}

// Host → organization mapping for multi-tenant routing (Phase 0 spine —
// docs/MULTI_TENANCY.md §0/§3.1). A domain maps to exactly one org; an org may
// hold several domains (subdomain + custom apex). `domain` is stored
// lowercased with no port. Rows are seeded via scripts/add-tenant-domain.ts
// (never a data migration). Unknown hosts fall back per the resolver's safety
// ramp in src/lib/tenant/resolver.ts — master keeps working with zero rows.
model TenantDomain {
  id             String    @id @default(cuid())
  organizationId String
  domain         String    @unique
  isPrimary      Boolean   @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model User {
  id              String    @id @default(cuid())
  organizationId  String?
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole  @default(ORGANIZER)
  specialty       String?
  emailVerified   DateTime?
  termsAcceptedAt DateTime?
  termsAcceptedIp String?
  image           String?
  emailSignature  String?   @db.Text
  /// Last time this account was seen making an authenticated request.
  ///
  /// Stamped from the NextAuth JWT callback, piggybacking on the role
  /// re-validation block that already runs at most every 5 minutes — so an
  /// active user costs one extra write per 5 minutes, not one per request.
  /// "Online now" = this within LAST_SEEN_ONLINE_WINDOW_MS (src/lib/active-users.ts).
  ///
  /// This is a scalar ON User rather than a side table, unlike WebinarPresence
  /// (which was deliberately kept off the hot Registration row). The scale is
  /// three orders of magnitude apart: WebinarPresence carries thousands of
  /// attendees heartbeating every 30s, whereas this is a handful of staff
  /// accounts at 5-minute granularity — nowhere near enough row churn to be
  /// worth a join on every read.
  lastSeenAt      DateTime?
  /// Session revocation counter (Aug 11, 2026). Sessions are stateless JWTs, so
  /// there is no session row to delete — a cookie keeps working until it
  /// expires no matter what happens to this user. Deleting the account did NOT
  /// log anyone out; their token kept its cached role indefinitely, because the
  /// rolling 24h window only expires on IDLE.
  ///
  /// This is the standard fix: the value is stamped into the token at sign-in
  /// and compared on the periodic re-validation that already runs. Bump it and
  /// every token issued for this user stops matching, so they are signed out.
  ///
  /// Bump on: password reset, and any explicit "sign this person out" action.
  /// Deliberately NOT on an ordinary role change — the same re-validation
  /// already rewrites the role in place, and bumping would only convert a
  /// silent downgrade into a forced sign-out WITHOUT making it any faster
  /// (both are bounded by the same 5-minute cycle). Promoting a colleague
  /// should not log them out.
  ///
  /// Deletion needs no bump either: the row is gone, so the re-validation's
  /// "user not found" branch invalidates the session on its own.
  ///
  /// It rides an existing query rather than adding one — the 5-minute block
  /// already reads this row for `role`, so this is one more column in the same
  /// `select`. See docs/SESSION_ARCHITECTURE.md.
  tokenVersion    Int       @default(0)
  /// May this person see the HR module? (owner, Aug 31 2026)
  ///
  /// HR used to follow from being an ADMIN. That was the mistake `hr-roles.ts`
  /// warns about in general terms: ADMIN means "runs the events business", it
  /// has never meant "may read a colleague's sick leave", and deriving one from
  /// the other made the population accidental. There are three admins and only
  /// two of them should be in there.
  ///
  /// So the grant is now explicit and per person, and it FAILS CLOSED: nobody
  /// is backfilled, a new admin gets nothing, and the box has to be ticked.
  /// SUPER_ADMIN and HR_USER do not need it (see `canViewHr`).
  ///
  /// It rides the session re-validation query that already reads this row, so
  /// it costs no extra round trip and a change takes effect on an internal
  /// user's next request rather than at their next sign-in.
  hrAccess        Boolean   @default(false)
  /// Set to deactivate an INTERNAL user without deleting them (Aug 11, 2026).
  /// Null means active. Their access stops immediately and they cannot sign
  /// back in, but the row and every foreign key pointing at it survive.
  ///
  /// Deliberately a TIMESTAMP, not a `DEACTIVATED` role value. A role answers
  /// "what may you do"; this answers "may you be here at all", and collapsing
  /// the two axes causes three problems: it OVERWRITES the real role (so
  /// reactivating means guessing what they were), it must be handled in every
  /// role predicate (canViewFinance, denyReviewer, isTeamRole,
  /// buildEventAccessWhere, the CRM set...) where a single miss leaves that
  /// capability intact, and it breaks every exhaustive Record<UserRole, ...>.
  /// As a flag it is checked in exactly ONE place and cannot fail open.
  ///
  /// Deactivating preserves ownership on purpose: CRM deals, sent-email
  /// attribution, audit rows, group coordinator and document uploader all keep
  /// pointing at them until someone reassigns. Deleting would SetNull most of
  /// those and silently orphan the work.
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization              Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  speakers                  Speaker[]
  registrations             Registration[]
  auditLogs                 AuditLog[]
  accounts                  Account[]
  sessions                  AuthSession[]
  notifications             Notification[]
  mediaFiles                MediaFile[]
  deviceTokens              DeviceToken[]
  scheduledEmails           ScheduledEmail[]
  mcpOAuthAuthCodes         McpOAuthAuthCode[]
  mcpOAuthAccessTokens      McpOAuthAccessToken[]
  abstractReviewerOf        AbstractReviewer[]         @relation("ReviewerOnAbstracts")
  assignedAbstractReviewers AbstractReviewer[]         @relation("AssignedAbstractReviewers")
  abstractSubmissions       AbstractReviewSubmission[] @relation("UserAbstractSubmissions")
  triggeredEmailLogs        EmailLog[]
  attachedBillingAccounts   EventBillingAccount[]
  issuedCertificates        IssuedCertificate[]
  triggeredCertificateRuns  CertificateIssueRun[]

  // CRM module — all SetNull on user delete, so removing a team member never
  // destroys deal/task/note history AND never blocks the delete. See CrmDeal.
  ownedCrmDeals            CrmDeal[]           @relation("CrmDealOwner")
  ownedCrmContacts         CrmContact[]        @relation("CrmContactOwner")
  ownedCrmTasks            CrmTask[]           @relation("CrmTaskOwner")
  authoredCrmNotes         CrmNote[]           @relation("CrmNoteAuthor")
  crmActivities            CrmActivity[]       @relation("CrmActivityActor")
  uploadedCrmDealDocuments CrmDealDocument[]   @relation("CrmDealDocumentUploader")
  crmNotifications         CrmNotification[]   @relation("CrmNotificationRecipient")
  createdCrmEmailTemplates CrmEmailTemplate[]  @relation("CrmEmailTemplateCreator")
  createdCrmProducts       CrmProduct[]        @relation("CrmProductCreator")
  sentCrmEmailMessages     CrmEmailMessage[]   @relation("CrmEmailMessageSender")
  uploadedSpeakerDocuments SpeakerDocument[]   @relation("SpeakerDocumentUploader")
  coordinatedGroups        RegistrationGroup[] @relation("CoordinatedGroups")
  loginEvents              LoginEvent[]
  /// HR: the employee record for this login, when the person is on staff.
  /// Muthu (Admin & Accounts Manager) is the live case: he records everyone's
  /// attendance AND has his own Employee row, so his own leave is a self-entry.
  /// Fine at this size, but it means there is no separation of duties, which is
  /// exactly why every attendance write is audited with the actor.
  employeeRecord           Employee?           @relation("EmployeeUser")

  @@index([organizationId])
  @@index([email])
  // "Who in my org was active recently?" — the Active Now card's only query.
  @@index([organizationId, lastSeenAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ORGANIZER
  MEMBER
  REVIEWER
  SUBMITTER
  REGISTRANT
  // CRM User — org-bound team role CONFINED to the CRM (sponsorship pipeline).
  // Can fully work the CRM (own deals, companies, CRM contacts, tasks, notes,
  // reports, export) and SEES deal values — but is blocked from everything
  // outside /crm: no events, registrations, speakers, invoices, settings.
  // NOT in FINANCE_ROLES (sees CRM deal money, not event invoices/payments);
  // buildEventAccessWhere returns zero events for it (it uses /api/crm/events-lite
  // for the name-only event picker). Added 2026-07-15. See src/crm/lib/crm-roles.ts.
  CRM_USER
  // Onsite Staff — registration-desk role, scoped PER EVENT (org-bound AND
  // assigned via Event.settings.onsiteUserIds — see buildEventAccessWhere).
  // Can ONLY create registrations + check attendees in + view the registrations
  // list + print badges, for its assigned events. Blocked from everything else.
  //
  // ONSITE is finance-CAPABLE (FINANCE_ROLES includes it, and MEMBER, since the
  // 2026-06-17 "desk staff record payments" decision) — it SEES payment amounts
  // for its assigned events. Do not assume money is hidden from it.
  ONSITE
  // Webinars team — org-bound internal staff (added 2026-08-03, owner spec:
  // "ONSITE role + webinar full control, not organizer"). TWO-TIER access:
  //  (1) ALL of the org's WEBINAR-type events: FULL organizer-grade control
  //      (create webinars, registrations, communications, console, content,
  //      event settings) — automatic, no per-event assignment.
  //  (2) Non-webinar events: ONSITE-equivalent registration desk ONLY, via the
  //      SAME per-event assignment list (Event.settings.onsiteUserIds).
  // Blocked from org-level surfaces (org settings/users/API keys, CRM,
  // invoices, reimbursements, refunds/credit-notes, certificates v1, agent).
  // Enforcement is opt-in per route (denyReviewer restricted set + allow
  // lists) with event resolution through buildEventAccessWhere — a missed
  // route fails CLOSED. Finance-capable (desk records payments) and holds
  // Zoom HOST credentials for webinar events (the producer role).
  WEBINARS
  // HR User — org-bound team role CONFINED to the HR module (attendance and
  // leave). Added 2026-08-27. Sees no events, registrations, speakers, invoices
  // or settings; buildEventAccessWhere returns zero events for it, and it is in
  // denyReviewer's restricted set so every non-HR write is refused.
  //
  // AVAILABILITY IS GATED SEPARATELY. The HR module is master-silo only
  // (HR_MODULE_ENABLED), so this role is not offered in the invite dropdown on
  // a deployment where the module is off. The enum value exists everywhere
  // because the enum is shared; being grantable is a different question from
  // existing.
  HR_USER
}

enum Title {
  DR
  MR
  MRS
  MS
  PROF
}

enum AttendeeRole {
  ACADEMIA
  ALLIED_HEALTH
  MEDICAL_DEVICES
  PHARMA
  PHYSICIAN
  RESIDENT
  SPEAKER
  STUDENT
  OTHERS
}

model Event {
  id                               String      @id @default(cuid())
  organizationId                   String
  name                             String
  slug                             String
  description                      String?     @db.Text
  startDate                        DateTime
  endDate                          DateTime
  timezone                         String      @default("Asia/Dubai")
  venue                            String?
  address                          String?
  city                             String?
  country                          String?
  eventType                        EventType?
  tag                              String?
  specialty                        String?
  code                             String?
  // Dubai (DET/DTCM) compliance: when true, the per-registration DTCM
  // barcode field is surfaced for this event. DTCM barcodes are a Dubai
  // tourism requirement and are NOT applicable to Abu Dhabi / Fujairah /
  // Al Ain / non-UAE events — organizer ticks this only for Dubai events.
  // It does NOT make DTCM the entry barcode (that's always qrCode); it
  // only controls visibility of the separate DTCM field.
  requiresDtcmBarcode              Boolean     @default(false)
  status                           EventStatus @default(DRAFT)
  settings                         Json        @default("{}")
  bannerImage                      String?
  // Optional phone banner (art-direction). When set it renders on screens
  // below 576px via a <picture> source; `bannerImage` shows at 576px and above.
  // Recommended ~700x300 (main banner ~1400x300). Null => the main banner is
  // used at every breakpoint.
  bannerImageMobile                String?
  footerHtml                       String?     @db.Text
  emailHeaderImage                 String?
  // Responsive logo / sign-off image rendered at the very bottom of
  // every event email body (below the optional emailFooterHtml).
  // Same responsive treatment as emailHeaderImage — width="600"
  // attribute + max-width:600px CSS so Outlook desktop and modern
  // clients both render at the email-body width.
  emailFooterImage                 String?
  emailFooterHtml                  String?     @db.Text
  emailFromAddress                 String?
  emailFromName                    String?
  // Addresses CC'd on every event-scoped email — both automated
  // (registration confirmation, speaker invite, abstract status,
  // bulk email, scheduled email) and manual single-sends from the
  // detail sheets. Empty array = no auto-CC.
  emailCcAddresses                 String[]    @default([])
  supportEmail                     String?
  registrationTermsHtml            String?     @db.Text
  registrationWelcomeHtml          String?     @db.Text
  abstractWelcomeHtml              String?     @db.Text
  sessionProposalWelcomeHtml       String?     @db.Text
  abstractGuidelinesHtml           String?     @db.Text
  abstractTermsHtml                String?     @db.Text
  /// Travel Grant (see docs/TRAVEL_GRANT_PLAN.md). Two texts, not one,
  /// because they answer different questions: the message says WHY you are
  /// receiving this and renders inside the abstract-submission confirmation
  /// email; the terms say WHAT you are agreeing to and render on the consent
  /// form itself, where they are snapshotted onto the row at consent.
  travelGrantMessageHtml           String?     @db.Text
  travelGrantTermsHtml             String?     @db.Text
  abstractConfirmationHtml         String?     @db.Text
  registrationConfirmationHtml     String?     @db.Text
  speakerAgreementHtml             String?     @db.Text
  /// Organizer-authored rich-text intro shown at the top of the public
  /// survey form (Tiptap WYSIWYG, sanitized on render). Null = use the
  /// default intro copy.
  surveyIntroHtml                  String?     @db.Text
  speakerAgreementTemplate         Json?
  /// Letterhead images for the generated agreement PDFs (the inline
  /// HTML→PDF paths only — an uploaded .docx speaker template carries its
  /// own branding). Full-page-width banners drawn at the top/bottom of
  /// every page. Local upload URLs under /uploads/agreements/{eventId}/ —
  /// PNG or JPEG only (pdfkit cannot embed WebP). The speaker and
  /// presenter agreements each have their own pair.
  speakerAgreementPdfHeaderImage   String?
  speakerAgreementPdfFooterImage   String?
  presenterAgreementPdfHeaderImage String?
  presenterAgreementPdfFooterImage String?
  /// Per-event post-event evaluation/feedback survey definition. Null
  /// when no survey is configured. Shape: ordered array of
  /// SurveyQuestion (discriminated union: single_select / rating_1_to_5
  /// / text) — see `src/lib/survey/schema.ts` for the Zod-validated
  /// type. Renderer pulls this at request time on both the admin
  /// builder + the public form, so changing it mid-collection is
  /// allowed but care must be taken not to invalidate in-flight
  /// responses (answer linkage is by question.id, not array index).
  surveyConfig                     Json?
  /// Organizer-generated reusable shareable survey link. Null when no
  /// link is active. Shape: `{ token, expiresAt, createdAt,
  /// createdByUserId }` — see `src/lib/survey/share-link.ts` for the
  /// Zod-validated shape. Token is stored PLAINTEXT (like
  /// Abstract.managementToken) so the dashboard can re-display the URL;
  /// a valid registrant email is still required to submit, so this only
  /// gates reaching the form. Lookup is slug-scoped (the public URL
  /// carries the slug), so no global token index is needed.
  surveyShareLink                  Json?
  taxRate                          Decimal?    @db.Decimal(5, 2)
  taxLabel                         String?     @default("VAT")
  bankDetails                      String?     @db.Text
  badgeVerticalOffset              Int         @default(0)
  // Event-wide attendee cap (July 24, 2026). Null = unlimited. Deliberately
  // NOT seeded from the legacy (never-enforced) `settings.maxAttendees` JSON
  // key — silently activating a forgotten number could block a live event's
  // registration; organizers re-enter the cap deliberately in Settings.
  maxAttendees                     Int?
  // The enforcement counter for maxAttendees — mirrors TicketType.soldCount.
  // Counts registrations that hold a ticket/tier seat (non-CANCELLED +
  // IN_PERSON + not a speaker companion; see seatCounter() in
  // src/lib/registration-seat.ts) — so virtual attendees and faculty never
  // consume the cap. Maintained via raw conditional UPDATEs (Prisma updateMany
  // can't compare seatCount < maxAttendees column-to-column); RECOMPUTED from
  // row-truth inside the same tx whenever an organizer sets/changes
  // maxAttendees, so pre-cap drift self-heals at the moment a cap goes live.
  seatCount                        Int         @default(0)
  // CME / CPD hours awarded for attending this event. Read by the CME
  // certificate template. Decimal(4,1) allows fractional hours up to
  // 999.9 — accreditors routinely award half-hour increments.
  // Nullable: events that aren't CME-accredited leave this empty and
  // the Issue CME button stays disabled. Per-event accreditor list
  // (DHA / DOH / SCFHS / EACCME / ACCME / OTHER — multiple allowed)
  // lives in `settings.cme.accreditations[]` JSON, not a separate
  // column, because: at most 2-3 accreditations per event in practice,
  // we never query by reference, and it matches the existing
  // settings-blob pattern (settings.zoom, settings.sponsors,
  // settings.webinar). Design-approval flag for cert templates lives
  // in `settings.cme.designApprovedBy` + `designApprovedAt`.
  cmeHours                         Decimal?    @db.Decimal(4, 1)
  externalId                       String?
  externalSource                   String?
  createdAt                        DateTime    @default(now())
  updatedAt                        DateTime    @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketTypes        TicketType[]
  registrations      Registration[]
  registrationGroups RegistrationGroup[]
  speakers           Speaker[]
  eventSessions      EventSession[]
  tracks             Track[]
  hotels             Hotel[]
  accommodations     Accommodation[]
  abstracts          Abstract[]
  abstractThemes     AbstractTheme[]
  abstractSubThemes  AbstractSubTheme[]
  reviewCriteria     ReviewCriterion[]
  auditLogs          AuditLog[]

  sessionProposals      SessionProposal[]
  sessionProposalThemes SessionProposalTheme[]

  importLogs                   ImportLog[]
  emailTemplates               EmailTemplate[]
  notifications                Notification[]
  mediaFiles                   MediaFile[]
  invoices                     Invoice[]
  invoiceCounters              InvoiceCounter[]
  registrationSerialCounter    RegistrationSerialCounter?
  abstractSerialCounter        AbstractSerialCounter?
  sessionProposalSerialCounter SessionProposalSerialCounter?
  billingAccounts              EventBillingAccount[]
  zoomMeetings                 ZoomMeeting[]
  zoomAttendances              ZoomAttendance[]
  webinarPresences             WebinarPresence[]
  promoCodes                   PromoCode[]
  scheduledEmails              ScheduledEmail[]
  eventStats                   EventStats?
  emailLogs                    EmailLog[]
  issuedCertificates           IssuedCertificate[]
  certificateSerialCounters    CertificateSerialCounter[]
  certificateIssueRuns         CertificateIssueRun[]
  certificateTemplates         CertificateTemplate[]
  surveyResponses              SurveyResponse[]
  rsvpCampaigns                RsvpCampaign[]
  rsvpItems                    RsvpItem[]
  rsvpInvites                  RsvpInvite[]
  speakerReimbursements        SpeakerReimbursement[]
  travelGrants                 TravelGrant[]
  dtcmCodes                    DtcmCode[]
  speakerProfileForms          SpeakerProfileForm[]

  // CRM module — SetNull, so a sponsorship deal (revenue history) outlives the
  // event it was sold against.
  crmDeals CrmDeal[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@index([startDate])
  @@index([externalSource, externalId])
}

// ==================== CERTIFICATES ====================

// Collapsed from 4 to 2 values on 2026-06-02. Designers typically hand
// the organizer two physical cert PDFs — "Certificate of Attendance"
// and "Certificate of Appreciation" — and the organizer modifies the
// per-recipient text via {{tokens}} on text boxes overlaid on each.
// PRESENTER + POSTER + CME were collapsed into APPRECIATION; CME
// metadata (hours + accrediting bodies) stays on the event itself and
// is rendered into either cert type via tokens (`{{cmeHours}}`,
// `{{accreditationBody}}`, `{{accreditationReference}}`).
enum CertificateType {
  ATTENDANCE
  APPRECIATION
}

/// Per-event-per-type atomic serial counter — mirrors RegistrationSerialCounter
/// (added 2026-05-18). One row per `(eventId, type)`. PK is composite so we
/// can upsert+increment in a single statement under concurrent issues
/// without P2002 collisions on `IssuedCertificate.serial`'s unique index.
///
/// Serials are CATEGORY-scoped, not template-scoped — a single attendance
/// numbering sequence covers Standard + VIP + any other Attendance variant
/// the organizer creates. The category is what reads as the cert's identity
/// in serial-number registries.
model CertificateSerialCounter {
  eventId        String
  type           CertificateType
  lastSerial     Int             @default(0)
  // tenancy (Certificates sweep): denormalized org, no FK. FLAT column on this
  // composite-PK counter for the RegistrationSerialCounter reason — the atomic
  // INSERT…ON CONFLICT upsert against a policy-invisible row would raise a
  // spurious unique violation the app misreads; a flat column the writer stamps
  // sidesteps it. Backfilled 1-hop from Event.
  organizationId String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, type])
  @@index([organizationId])
}

/// User-defined certificate template (2026-06-02 — N templates per event-per-
/// category, replacing the previous 2-slot JSON on Event.settings). Each
/// row carries its own background PDF + positioned text boxes; the operator
/// can have multiple Attendance designs (e.g. "Standard", "VIP", "Sponsor
/// Guest") and multiple Appreciation designs (e.g. "Speaker", "Moderator",
/// "Chairman") per event.
///
/// `category` derives the eligibility query (Attendance → checked-in
/// registrants; Appreciation → speakers + poster authors). One cert per
/// recipient per category — the uniqueness on IssuedCertificate prevents
/// double-issue even when multiple templates of the same category exist.
///
/// Template DELETE is blocked at the application layer when any
/// IssuedCertificate still references it (FK is SetNull so the row can be
/// orphaned in extremis, but the API rejects). This preserves issued-cert
/// audit trail integrity.
model CertificateTemplate {
  id                String          @id @default(cuid())
  eventId           String
  // tenancy (Certificates sweep): denormalized org, no FK. Backfilled 1-hop from Event.
  organizationId    String?
  name              String // organizer-defined, e.g. "VIP Attendance"
  category          CertificateType // ATTENDANCE | APPRECIATION
  // Role/designation this template certifies (e.g. "Speaker", "Moderator",
  // "Organizing Committee"). Drives the {{role}} token. Lets one person hold
  // several role-specific certs — uniqueness is per-template (see
  // IssuedCertificate @@unique), so 3 role-templates → 3 certs.
  role              String?
  // Static per-template CME hours (organizer-entered). Snapshotted onto the
  // issued cert; overrides the event-level CME hours when set.
  cmeHours          Decimal?        @db.Decimal(4, 1)
  // Phase-2 survey-gated auto-issue. When `autoIssueOnSurvey` is on, the
  // cert worker auto-issues this template to anyone who completes the
  // survey AND holds `autoIssueTag` (attendee tag for ATTENDANCE, speaker
  // tag for APPRECIATION). Off by default — opt-in per template.
  autoIssueOnSurvey Boolean         @default(false)
  autoIssueTag      String?
  backgroundPdfUrl  String?
  // CertificateTextBox[] — same shape as src/lib/certificates/types.ts
  textBoxes         Json            @default("[]")
  sortOrder         Int             @default(0)
  // Per-template default cover email (cert PDF is always attached). Both
  // nullable — when null the Issue dialog pre-fills the system default.
  // Tokens supported in body: recipientName, eventName, eventDateRange,
  // venueLine, organizationName, certificateType, certificateSerial,
  // plus abstractTitle on APPRECIATION templates.
  emailSubject      String?
  emailBody         String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  event              Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  issuedCertificates IssuedCertificate[]
  issueRuns          CertificateIssueRun[]

  @@index([eventId, category, sortOrder])
  @@index([organizationId])
}

/// Audit record of a certificate that was actually issued + emailed. One row
/// per (event, type, recipient) — the dual @@unique constraints prevent
/// accidental double-issue from concurrent operator clicks or MCP retries.
///
/// `recipientSnapshot` and `cmeHoursSnapshot` lock in the values at issue
/// time so a reprint months later matches the original PDF byte-for-byte
/// even if the underlying Attendee/Speaker/Event record drifts. Mirrors
/// the immutability strategy `Speaker.agreementTextSnapshot` uses for
/// legal-text fixity.
model IssuedCertificate {
  id                    String          @id @default(cuid())
  eventId               String
  // tenancy (Certificates sweep): denormalized org, no FK. Backfilled 1-hop from Event.
  organizationId        String?
  registrationId        String?
  speakerId             String?
  type                  CertificateType
  /// Specific template that rendered this cert. Nullable so legacy rows
  /// (pre-2026-06-02 multi-template flip) survive; new issues always set it.
  /// SetNull on template delete — audit trail preserved even if the
  /// organizer later deletes the template that produced this cert.
  certificateTemplateId String?
  serial                String          @unique
  issuedAt              DateTime        @default(now())
  /// Operator who issued this cert. NULL for survey-gated auto-issued
  /// certs (Phase 2) — no human clicked Issue, the worker did it on
  /// survey completion. The owning CertificateIssueRun.autoIssue flag
  /// records the same fact at the run level.
  issuedByUserId        String?
  lastReprintedAt       DateTime?
  reprintCount          Int             @default(0)
  /// Tracks individual-recipient resends from the registration/speaker
  /// detail sheets (distinct from reprint which re-renders the PDF —
  /// resend reuses the existing pdfUrl and just re-fires the delivery
  /// email). Each resend bumps both fields atomically. resendCount=0
  /// means the cert was sent once via the original CertificateIssueRun
  /// and never resent.
  lastResentAt          DateTime?
  resendCount           Int             @default(0)
  /// Re-render + resend from the CURRENT template (the "resend latest version"
  /// action + bulk reissue). Distinct from resendCount (which replays the
  /// frozen original) — a reissue re-renders the PDF AND re-sends, so it also
  /// bumps reprintCount + resendCount, but reissueCount is the clean count of
  /// how many times the recipient got a *refreshed* certificate.
  lastReissuedAt        DateTime?
  reissueCount          Int             @default(0)
  revokedAt             DateTime?
  revocationReason      String?

  // Frozen at issue time. Schema:
  //   { title, firstName, lastName, fullName (formatted),
  //     organization?, jobTitle?, city?, country? }
  recipientSnapshot Json
  cmeHoursSnapshot  Decimal? @db.Decimal(4, 1)

  // URL to the rendered PDF — populated by the issue cron during the
  // RENDERING phase. Path convention: /uploads/certificates/{eventId}/{certId}.pdf
  // (local) or certificates/{eventId}/{certId}.pdf (Supabase storage).
  // Reused for re-download + email attachment so we don't re-render. NULL
  // until the render phase completes for this cert.
  pdfUrl String?

  /// The run item that produced/delivered this cert — the 1:N side of the
  /// multi-cert-per-email model (one person-keyed run item can carry several
  /// certs, one per template in the run's templateIds). The legacy 1:1 link
  /// (CertificateIssueRunItem.issuedCertificateId, relation
  /// "RunItemPrimaryCert") still gets the FIRST cert so pre-bundle readers
  /// keep working. SetNull so deleting a run keeps the cert audit trail.
  issueRunItemId String?

  event               Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration        Registration?            @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  speaker             Speaker?                 @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  issuedBy            User?                    @relation(fields: [issuedByUserId], references: [id])
  certificateTemplate CertificateTemplate?     @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  issueRunItem        CertificateIssueRunItem? @relation("RunItemPrimaryCert")
  deliveredViaItem    CertificateIssueRunItem? @relation("RunItemBundleCerts", fields: [issueRunItemId], references: [id], onDelete: SetNull)

  // One cert per TEMPLATE per recipient (was per type) — lets one person hold
  // multiple role-specific certs (Speaker + Moderator + Committee), each from
  // its own template. Safe swap on live data: every existing (event, type,
  // person) holds ≤1 cert and a template belongs to one type, so no collision
  // on (event, template, person); null-template legacy certs are distinct.
  @@unique([eventId, certificateTemplateId, registrationId])
  @@unique([eventId, certificateTemplateId, speakerId])
  @@index([eventId, type])
  @@index([certificateTemplateId])
  @@index([serial])
  @@index([issueRunItemId])
  @@index([organizationId])
}

/// Bulk certificate-issuing run. One row per "issue all certificates of
/// type X" operator action. Drives a two-phase pipeline:
///   PENDING → RENDERING → AWAITING_REVIEW → SENDING → COMPLETED
/// The AWAITING_REVIEW gate is the operator preview — they can verify
/// the rendered PDFs look right before emails go out.
///
/// The cron worker /api/cron/certificate-issues picks up runs in
/// non-terminal states and drains them in batches of 50 per tick. App-
/// level guard in POST /issue ensures only one non-terminal run per
/// (event, type) so concurrent operator clicks don't double-issue.
model CertificateIssueRun {
  id                    String             @id @default(cuid())
  eventId               String
  // tenancy (Certificates sweep): denormalized org, no FK. Backfilled 1-hop from
  // Event. The cert worker reads this off the run row to wrap each run's
  // render/send in runWithTenant (org-blind candidate scan, per-run wrap).
  organizationId        String?
  type                  CertificateType
  /// Which template fired this run. Nullable for legacy rows (pre-flip);
  /// SINGLE-template runs still set it (legacy readers depend on it). A
  /// MULTI-template bundle run leaves it null and lists its templates in
  /// `templateIds`. SetNull on template delete — the run row survives as
  /// audit even if the template is later removed.
  certificateTemplateId String?
  /// Multi-cert-per-email model: ALL templates this run issues (1..3).
  /// Empty array = legacy single-template run → read certificateTemplateId.
  /// Plain id array (not a junction) — runs are short-lived work orders;
  /// the durable template link lives on each IssuedCertificate.
  templateIds           String[]           @default([])
  status                CertIssueRunStatus @default(PENDING)
  totalCount            Int
  renderedCount         Int                @default(0)
  emailedCount          Int                @default(0)
  failedCount           Int                @default(0)
  /// Operator who clicked Issue. NULL for survey-gated auto-issue runs
  /// (Phase 2) — created by the worker, no operator. See `autoIssue`.
  triggeredByUserId     String?
  /// True when this run was created automatically by the survey-gated
  /// cert worker (Phase 2). Auto runs SKIP the AWAITING_REVIEW gate:
  /// render → SENDING directly, so the cert lands in the inbox without
  /// an operator click. Manual runs (false) keep the review gate.
  autoIssue             Boolean            @default(false)
  /// True when this run RE-RENDERS + re-sends already-issued certs from the
  /// CURRENT template (bulk "resend latest to everyone") instead of issuing
  /// new ones. Reissue runs skip the render/AWAITING_REVIEW gates: the worker
  /// drains each item via reRenderAndResendCert (re-render existing + resend).
  reissue               Boolean            @default(false)
  triggeredAt           DateTime           @default(now())
  rendererStartedAt     DateTime?
  rendererFinishedAt    DateTime?
  emailerStartedAt      DateTime?
  emailerFinishedAt     DateTime?
  // Heartbeat — cron worker updates on every tick. Stall detector
  // reclaims any IN_PROGRESS run (RENDERING / SENDING) whose lastTickAt
  // is older than 10 minutes back to PENDING / AWAITING_REVIEW so a
  // crashed mid-tick run doesn't get stuck forever.
  lastTickAt            DateTime?
  // [{ recipientName, phase, code, message }] — capped at last 100 in code.
  errors                Json?
  // Optional: when SENDING completes, snapshot the sender's cc list so
  // re-runs can replay. Not required for v1.
  notes                 String?
  // Snapshot of the email content the operator confirmed at Issue time
  // (copied from the template default into the dialog, optionally
  // tweaked, then frozen onto the run). The send phase reads from here
  // — NOT from the template — so a template-default-change mid-run
  // doesn't retroactively alter the in-flight emails.
  emailSubject          String?
  emailBody             String?            @db.Text

  event               Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  triggeredBy         User?                     @relation(fields: [triggeredByUserId], references: [id])
  certificateTemplate CertificateTemplate?      @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  items               CertificateIssueRunItem[]

  @@index([eventId, type, status])
  @@index([certificateTemplateId])
  @@index([status, lastTickAt])
  @@index([organizationId])
}

enum CertIssueRunStatus {
  PENDING
  RENDERING
  AWAITING_REVIEW
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

/// One row per (run, recipient) — the unit of work the cron drains.
/// Disambiguated by registrationId XOR speakerId. Carries per-item
/// progress (renderedAt, issuedCertificateId, emailedAt, error*) so
/// the cron can resume mid-batch + re-issue-failed-only is trivial.
model CertificateIssueRunItem {
  id                  String    @id @default(cuid())
  runId               String
  // tenancy (Certificates sweep): denormalized org, no FK. Backfilled 2-hop
  // from Event via the parent CertificateIssueRun (stamped first).
  organizationId      String?
  registrationId      String?
  speakerId           String?
  // Snapshot at run-creation time — used to display the recipient list
  // in the UI without joining + handles the case where the underlying
  // Registration/Speaker is later cancelled (we still want to show
  // who was on the run).
  recipientName       String
  recipientEmail      String?
  /// The subset of the run's templateIds THIS person earned at issue time
  /// (tag-matched per facet). The render phase issues exactly these — facet
  /// presence alone can't disambiguate two same-category templates. Empty =
  /// legacy item → falls back to the run's template list.
  templateIds         String[]  @default([])
  renderedAt          DateTime?
  issuedCertificateId String?   @unique
  emailedAt           DateTime?
  errorPhase          String? // "render" | "email"
  errorMessage        String?

  run                CertificateIssueRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  registration       Registration?       @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  speaker            Speaker?            @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  /// Legacy 1:1 link — the FIRST cert this item produced. Kept populated on
  /// every new write so pre-bundle readers (issued list, resend route, run
  /// UI) work unchanged. Bundle runs link EVERY cert via bundleCertificates.
  issuedCertificate  IssuedCertificate?  @relation("RunItemPrimaryCert", fields: [issuedCertificateId], references: [id])
  /// All certs produced/delivered by this (person-keyed) item — one per
  /// applicable template in the run's templateIds.
  bundleCertificates IssuedCertificate[] @relation("RunItemBundleCerts")

  @@unique([runId, registrationId])
  @@unique([runId, speakerId])
  @@index([runId, renderedAt])
  @@index([runId, emailedAt])
  @@index([organizationId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  CANCELLED
}

enum EventType {
  CONFERENCE
  WEBINAR
  HYBRID
}

// ==================== SURVEY ====================
// Per-event post-event feedback survey. Question definitions live as
// JSON on `Event.surveyConfig` (see prisma/schema.prisma:~205 and
// src/lib/survey/schema.ts for the Zod-validated type). Each
// registration can submit AT MOST one response — the unique
// (eventId, registrationId) constraint is the dedup gate. The submit
// handler also writes the "survey-completed" tag onto Attendee.tags,
// which the cert Issue UI's tag picker filters by (CME certs gate on
// it; ATTENDANCE certs typically don't). See
// docs/SURVEYS.md (when added) for the full operator workflow.

model SurveyResponse {
  id             String   @id @default(cuid())
  eventId        String
  /// Multi-tenancy Phase-2 (Domain #16, Aug 3 2026): denormalized tenant key
  /// (nullable, no FK), backfilled 1-hop from Event; the public submit stamps
  /// it from the registration's event. Backs the flat RLS policy in
  /// prisma/rls/survey.sql (platform-only; master ignores it).
  organizationId String?
  /// One response per registration — enforced by `@unique`. The 1:1
  /// relation requires this on the FK side; conceptually it's also
  /// the dedup gate (a second POST returns 200 no-op via P2002).
  registrationId String   @unique
  submittedAt    DateTime @default(now())
  /// Hashed (NEXTAUTH_SECRET-peppered) source IP, for abuse triage
  /// without leaking the raw address. Optional — empty for anonymous
  /// flows we don't currently support.
  ipHash         String?
  /// Frozen answers keyed by question.id from Event.surveyConfig at
  /// submit time. Values are typed by the question type:
  ///   single_select → string (one of the configured options)
  ///   rating_1_to_5 → number 1..5
  ///   text          → string
  /// Skipped (optional) questions are absent from the map, NOT null.
  answers        Json

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId, submittedAt])
  @@index([organizationId])
}

// ==================== REGISTRATION & TICKETING ====================

model TicketType {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?  @db.Text
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  // Faculty/speaker ticket type — hidden from public registration and excluded
  // from paid-capacity counting. The auto-provisioned "Faculty" type that backs
  // speaker companion registrations (comp, uncapped) carries this flag.
  isFaculty   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Deprecated: kept for migration backward compat, will be removed
  category         String    @default("Standard")
  price            Decimal   @default(0) @db.Decimal(10, 2)
  /// Flat price charged when a registrant picks VIRTUAL attendance on a
  /// HYBRID event. null ⇒ virtual uses the in-person `price`. 0 ⇒ free
  /// virtual. Pricing tiers (Early Bird, etc.) apply to IN_PERSON only in v1.
  virtualPrice     Decimal?  @db.Decimal(10, 2)
  currency         String    @default("USD")
  quantity         Int       @default(999999)
  soldCount        Int       @default(0)
  maxPerOrder      Int       @default(10)
  salesStart       DateTime?
  salesEnd         DateTime?
  requiresApproval Boolean   @default(false)

  /// Supporting-document policy for this rate (Aug 13, 2026). Replaces the
  /// name-pattern guess (/resident|trainee/i) the Resident letter shipped
  /// with: configuration encoded in a NAME is configuration nobody can see,
  /// change or audit — renaming "Resident" to "Junior Doctor" silently turned
  /// the requirement off. See docs/PER_TYPE_DOCUMENT_UPLOAD_PLAN.md.
  ///
  /// The two booleans are deliberately NOT one tri-state enum: collapsing them
  /// makes "show the field but do not block" unrepresentable, and that is the
  /// default the letter shipped with for a real reason — some events would
  /// rather take the registration and chase the paperwork than lose a delegate
  /// at the form at 11pm.
  ///
  /// Asks this type's registrants for a document.
  requiresDocument     Boolean @default(false)
  /// ...and refuses the registration when it is missing. Ignored unless
  /// `requiresDocument` is true.
  documentRequired     Boolean @default(false)
  /// Organizer-authored field label, e.g. "Official Letter" / "Membership Card".
  documentLabel        String?
  /// Organizer-authored instructions rendered above the file input.
  documentInstructions String? @db.Text

  /// Denormalized tenant key (multi-tenancy Phase 2, ticketing follow-on).
  /// Scalar, no FK — backfilled 1-hop from Event; RLS-gated on the platform.
  organizationId String?

  event          Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pricingTiers   PricingTier[]
  registrations  Registration[]
  promoCodeLinks PromoCodeTicketType[]

  @@index([eventId])
  @@index([isActive])
  @@index([organizationId])
}

model PricingTier {
  id               String    @id @default(cuid())
  ticketTypeId     String
  name             String
  price            Decimal   @default(0) @db.Decimal(10, 2)
  currency         String    @default("USD")
  quantity         Int       @default(999999)
  soldCount        Int       @default(0)
  maxPerOrder      Int       @default(10)
  salesStart       DateTime?
  salesEnd         DateTime?
  isActive         Boolean   @default(true)
  requiresApproval Boolean   @default(false)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Denormalized tenant key (multi-tenancy Phase 2, ticketing follow-on).
  /// Scalar, no FK — backfilled 2-hop via TicketType → Event.
  organizationId String?

  ticketType    TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([ticketTypeId, name])
  @@index([ticketTypeId])
  @@index([isActive])
  @@index([organizationId])
}

model Attendee {
  id               String        @id @default(cuid())
  // Denormalized tenant key (multi-tenancy Phase-2 Registration-core sweep).
  // Attendee has NO event link — the org is derived from its registrations'
  // events (backfill stamps only rows whose registrations all agree on ONE
  // org; orphans/conflicted stay NULL and fail closed under RLS). The public
  // register orphan-reuse lookup binds this column so one tenant can never
  // adopt + overwrite another tenant's attendee PII. Same person registering
  // with two tenants = two Attendee rows, by design.
  organizationId   String?
  title            Title?
  role             AttendeeRole?
  email            String
  additionalEmail  String?
  firstName        String
  lastName         String
  organization     String?
  jobTitle         String?
  phone            String?
  photo            String?
  city             String?
  state            String?
  zipCode          String?
  country          String?
  bio              String?       @db.Text
  specialty        String?
  customSpecialty  String?
  registrationType String?
  tags             String[]      @default([])
  dietaryReqs      String?
  associationName  String?
  memberId         String?
  studentId        String?
  studentIdExpiry  DateTime?
  customFields     Json          @default("{}")
  externalId       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  registrations Registration[]

  @@index([email])
  @@index([organizationId])
}

model Registration {
  id                         String                     @id @default(cuid())
  eventId                    String
  // Denormalized tenant key (multi-tenancy Phase-2 Registration-core sweep) —
  // scalar only, no FK (RLS + compound-where need the value, not a relation).
  // Stamped by every writer; backfilled from Event by migration 20260728160000.
  organizationId             String?
  ticketTypeId               String?
  pricingTierId              String?
  attendeeId                 String
  userId                     String?
  serialId                   Int?
  status                     RegistrationStatus         @default(PENDING)
  paymentStatus              PaymentStatus              @default(UNPAID)
  /// venue vs online; only a choice on HYBRID events. VIRTUAL ⇒ no
  /// qrCode/badge, uncapped (skips soldCount), no DTCM barcode.
  attendanceMode             AttendanceMode             @default(IN_PERSON)
  qrCode                     String?                    @unique
  /// DTCM compliance code. NOT unique since Aug 27 2026 (owner decision, asked
  /// twice): two registrations may deliberately share one code. See the
  /// migration and docs/DTCM.md for what that costs — the pool's spare maths is
  /// unaffected (it counts DISTINCT codes), but a scan of a shared code cannot
  /// identify one person, so the check-in route refuses an ambiguous DTCM scan
  /// and points the desk at the entry barcode, which is still unique per person.
  dtcmBarcode                String?
  badgeType                  String?
  referrer                   String?
  utmSource                  String?
  utmMedium                  String?
  utmCampaign                String?
  checkedInAt                DateTime?
  /// First time this registrant entered our webinar lobby / joined the live
  /// view (set by the presence heartbeat). Durable "Joined" indicator; the
  /// live who's-here-now state lives in WebinarPresence. Same write-once
  /// convention as checkedInAt.
  webinarFirstJoinedAt       DateTime?
  // Badge-print analytics: first-print timestamp + total prints (reprints
  // bump the count). Set by the badge route; powers "badges printed vs
  // registered" and reprint metrics. Per-print history lives in AuditLog
  // (action BADGE_PRINTED).
  badgePrintedAt             DateTime?
  badgePrintCount            Int                        @default(0)
  /// Set when the registrant submits the post-event feedback survey
  /// at `/e/[slug]/survey?token=...`. Used by the reporting view +
  /// audit trail; NOT consumed by the cert eligibility query (the
  /// cert system filters by `Attendee.tags` containing "survey-
  /// completed" which the same submit handler writes). Mirrors the
  /// existing `checkedInAt` / `badgePrintedAt` convention.
  surveyCompletedAt          DateTime?
  /// Phase-2 survey-gated cert auto-issue state. The cert worker sweeps
  /// registrations where `surveyCompletedAt IS NOT NULL AND
  /// certAutoIssueCheckedAt IS NULL AND (nextAttemptAt IS NULL OR <= now)`,
  /// resolves matching auto-issue templates (per tag), enqueues the certs,
  /// then stamps `checkedAt` (terminal). On a transient failure it bumps
  /// `attempts`, records `error`, and sets `nextAttemptAt = now + backoff`
  /// (exponential) so the row defers instead of blocking the queue; after
  /// MAX attempts it gives up terminally (checkedAt set + error kept).
  /// Derivable analytics state:
  ///   checkedAt NULL, attempts 0           → pending (first sweep)
  ///   checkedAt NULL, attempts > 0         → retrying/backing off
  ///   checkedAt set,  error NULL           → resolved OK
  ///   checkedAt set,  error non-NULL       → gave up after retries
  /// Partial index in the migration keeps the candidate scan cheap.
  certAutoIssueCheckedAt     DateTime?
  certAutoIssueAttempts      Int                        @default(0)
  certAutoIssueNextAttemptAt DateTime?
  certAutoIssueError         String?
  /// Which code path created this row — public form vs admin add vs
  /// MCP agent vs CSV import etc. See enum `RegistrationCreatedSource`
  /// for the full list. NULL on historical rows that pre-date the
  /// column; the detail sheet renders "Unknown" for those.
  createdSource              RegistrationCreatedSource?
  notes                      String?                    @db.Text
  /// Supporting document substantiating this registration's rate (an
  /// institutional letter, a membership card, a certificate) — the path to the
  /// uploaded file. Served ONLY via the authed staff route (the public
  /// /uploads catch-all blocks the prefix): it names a person, their employer
  /// and may carry a signature. See src/lib/supporting-document.ts.
  ///
  /// @map to the ORIGINAL column names: this shipped Aug 12 2026 as a
  /// Resident-only letter and was generalised Aug 13. Deploys are blue/green
  /// (migrations run BEFORE the container swap), so an ALTER ... RENAME COLUMN
  /// would leave the still-live old container querying a column that no longer
  /// exists. @map gives the honest field name at zero migration risk; the
  /// physical rename is a later cleanup, not a blocker.
  supportingDocumentUrl      String?                    @map("residentLetterUrl")
  /// The registrant's own filename, kept for the download and so staff can see
  /// what was sent. The stored file is renamed to a uuid.
  supportingDocumentFilename String?                    @map("residentLetterFilename")
  // Billing details (for invoices/tax)
  taxNumber                  String?
  billingFirstName           String?
  billingLastName            String?
  billingEmail               String?
  billingPhone               String?
  billingAddress             String?
  billingCity                String?
  billingState               String?
  billingZipCode             String?
  billingCountry             String?
  // Promo code discount
  promoCodeId                String?
  discountAmount             Decimal?                   @db.Decimal(10, 2)
  originalPrice              Decimal?                   @db.Decimal(10, 2)
  /// Running total refunded so far (partial refunds accumulate here). The
  /// registration stays PAID while 0 < refundedAmount < paidTotal and flips
  /// to REFUNDED only when the full paid amount is returned. The Billing UI
  /// shows "Refunded X of Y". Written by the refund route + charge.refunded
  /// webhook reconciliation.
  refundedAmount             Decimal                    @default(0) @db.Decimal(10, 2)
  // Sponsor attribution — set when paymentStatus = INCLUSIVE so reports
  // can group "all Abbott-sponsored attendees." References the entry's
  // id inside Event.settings.sponsors[] JSON (no FK because sponsors
  // are stored as a JSON array on the event, not a Prisma table).
  sponsorId                  String?
  // Third-party billing ("charge to another account") — when set, the
  // invoice is addressed to this BillingAccount (the attendee's hospital,
  // or a pharma/grant covering this specific doctor) instead of the
  // attendee. ORTHOGONAL to paymentStatus: money is still owed and the
  // registration stays UNPAID/PENDING until the payer settles — this only
  // redirects the bill-to party. null = self-pay (unchanged behavior).
  billingAccountId           String?
  // Optional PO / grant / authorization reference printed on the invoice.
  payerReference             String?
  /// Open Stripe Checkout session for this registration, stored at session
  /// create so a CANCEL can EXPIRE it (review H2 sub-item — sessions live
  /// ~24h and a cancelled attendee's still-open payment tab could complete).
  /// Cleared when the session completes or expires.
  stripeCheckoutSessionId    String?
  // Per-registration fallback: when true, an unpaid third-party invoice
  // may be reassigned back to the attendee (finance action); also keeps
  // the attendee's Pay-Now path available as a guarantor.
  attendeeIsGuarantor        Boolean                    @default(false)
  /// Group-registration membership (docs/GROUP_REGISTRATION_PLAN.md).
  /// SetNull: a member survives group deletion as a normal registration.
  groupId                    String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  event                    Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType               TicketType?               @relation(fields: [ticketTypeId], references: [id])
  pricingTier              PricingTier?              @relation(fields: [pricingTierId], references: [id])
  attendee                 Attendee                  @relation(fields: [attendeeId], references: [id])
  user                     User?                     @relation(fields: [userId], references: [id])
  promoCode                PromoCode?                @relation(fields: [promoCodeId], references: [id])
  billingAccount           BillingAccount?           @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  group                    RegistrationGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  payments                 Payment[]
  accommodation            Accommodation?
  invoices                 Invoice[]
  promoRedemption          PromoCodeRedemption?
  zoomAttendances          ZoomAttendance[]
  webinarPresences         WebinarPresence[]
  issuedCertificates       IssuedCertificate[]
  certificateIssueRunItems CertificateIssueRunItem[]
  // Speakers imported from this registration (0 or 1 in practice; the link
  // is best-effort + nullable, set on the import-registrations path).
  importedSpeakers         Speaker[]                 @relation("SpeakerSourceRegistration")
  surveyResponse           SurveyResponse?
  refundAttempts           RefundAttempt[]

  @@unique([eventId, serialId])
  @@index([sponsorId])
  @@index([billingAccountId])
  @@index([groupId])
  @@index([eventId])
  @@index([organizationId])
  @@index([eventId, status])
  @@index([eventId, ticketTypeId])
  @@index([eventId, attendanceMode])
  @@index([dtcmBarcode])
  @@index([pricingTierId])
  @@index([attendeeId])
  @@index([userId])
  @@index([promoCodeId])
  @@index([status])
  @@index([qrCode])
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  WAITLISTED
  CHECKED_IN
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  COMPLIMENTARY
  REFUNDED
  FAILED
  UNASSIGNED
  INCLUSIVE
}

/// Whether a registrant attends physically at the venue or online.
/// Only surfaced as a choice on HYBRID events. IN_PERSON is the default
/// and the back-compat value for every pre-existing registration.
/// VIRTUAL registrations get NO entry barcode/badge and are uncapped
/// (they don't consume the ticket-type seat count).
enum AttendanceMode {
  IN_PERSON
  VIRTUAL
}

/// Identifies which entry path created a Registration. Used by the
/// detail sheet to show "where did this row come from" so an
/// organizer can tell a self-service public registration from an
/// admin-entered one at a glance. NULL on historical rows that
/// pre-date the column.
enum RegistrationCreatedSource {
  /// Public registration form `/e/[slug]/register/[category]` — the
  /// canonical self-service path. Free + paid both land here.
  PUBLIC_REGISTER
  /// Public abstract-submitter sign-up at `/e/[slug]/abstract/register`
  /// — creates a SUBMITTER user + a Registration in one shot.
  PUBLIC_SUBMITTER
  /// Token-gated completion form at `/e/[slug]/complete-registration`
  /// — used after a CSV import where the admin sends "complete your
  /// registration" emails to imported rows.
  PUBLIC_COMPLETION_FORM
  /// Admin "Add Registration" full-page form or dialog on the
  /// dashboard registrations list. Goes through registration-service.
  ADMIN_DASHBOARD
  /// Bulk CSV import via the dashboard CSV importer.
  CSV_IMPORT
  /// MCP agent tool — `create_registration` or
  /// `create_registrations_bulk` called by an external integration
  /// (n8n, Claude Desktop, claude.ai web).
  MCP_AGENT
  /// Auto-created companion registration backing a Speaker (the "attendee
  /// facet"): comp, uncapped Faculty type, organizer-added. Gives the
  /// speaker badge/barcode/DTCM/check-in/survey via the normal machinery.
  SPEAKER_COMPANION
  /// Member of a group registration — created by the coordinator via the
  /// public `/e/[slug]/group/register` flow (docs/GROUP_REGISTRATION_PLAN.md).
  /// The company payer covers the money (billingAccountId + groupId set);
  /// members are never dunned individually.
  GROUP_REGISTER
  /// Catch-all for legacy paths or paths we haven't tagged yet.
  /// Rows landing here are a signal to extend coverage.
  OTHER
}

/// Group registration (docs/GROUP_REGISTRATION_PLAN.md, Phase 1) — the anchor
/// for a company rep ("coordinator") registering N people with ONE payer and
/// ONE consolidated invoice. The structural reason it exists: Invoice /
/// Payment historically required exactly one Registration; a consolidated
/// document spanning N members needs this row to hang off instead
/// (`Invoice.groupId` / `Payment.groupId` — app-level XOR with
/// `registrationId`). Line items are DERIVED at render time from the member
/// registrations, grouped by ticket type — never stored.
model RegistrationGroup {
  id                   String   @id @default(cuid())
  eventId              String
  // Denormalized tenant key (born-compliant per the Phase-2 convention) —
  // scalar only, no FK; stamped from the Event at create.
  organizationId       String?
  /// The REGISTRANT account that manages the group ("My Group"). Nullable +
  /// SetNull so deleting a temp account never destroys the group; the
  /// snapshot fields below keep the contact identity for organizer surfaces
  /// and the invoice contact line.
  coordinatorUserId    String?
  coordinatorName      String
  coordinatorEmail     String
  /// false = the coordinator is contact-only (companies outsource this);
  /// true = their details are also member #1 (a Registration linked to them).
  coordinatorAttending Boolean  @default(true)
  /// The company payer — REQUIRED (the whole point of a group). Restrict
  /// mirrors Registration.billingAccountId: a payer backing a group cannot
  /// be hard-deleted (soft-delete via isActive).
  billingAccountId     String
  /// Optional PO / grant reference for the consolidated invoice (also
  /// stamped onto member rows so per-registration surfaces agree).
  payerReference       String?
  /// Promo code negotiated for this group (Aug 2026, owner: "the code is
  /// against the full and final invoice").
  ///
  /// Held on the GROUP rather than on a member or on one invoice, because the
  /// discount belongs to the deal: when members are added and an unpaid
  /// invoice is cancelled and reissued, the reissued invoice must carry the
  /// same code. The money itself lands on `Invoice.discountCode` /
  /// `discountAmount`, so each issued document stays a frozen snapshot.
  ///
  /// SetNull: deleting a promo code must never take a group's registrations
  /// with it — the invoices already issued keep their own frozen discount.
  promoCodeId          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  coordinator    User?          @relation("CoordinatedGroups", fields: [coordinatorUserId], references: [id], onDelete: SetNull)
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  promoCode      PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  registrations  Registration[]
  invoices       Invoice[]
  payments       Payment[]

  @@index([eventId])
  @@index([organizationId])
  @@index([coordinatorUserId])
  @@index([billingAccountId])
  @@index([promoCodeId])
}

model Payment {
  id                String        @id @default(cuid())
  /// Nullable since the group-registration build (Aug 2026): a payment
  /// belongs to EITHER one registration OR one group — app-level XOR with
  /// `groupId` (exactly one set). Single-registration payments are unchanged.
  registrationId    String?
  /// Group settlement — one card charge / transfer covering all members
  /// (docs/GROUP_REGISTRATION_PLAN.md).
  groupId           String?
  // Denormalized tenant key (multi-tenancy Phase-2 Registration-core sweep,
  // 2 hops from Event via Registration) — see Registration.organizationId.
  organizationId    String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  stripePaymentId   String?       @unique
  stripeCustomerId  String?
  status            PaymentStatus @default(PENDING)
  /// Per-PAYMENT refunded running total (review H6/M4, July 10 2026). The
  /// registration-level `Registration.refundedAmount` mixes Stripe + manual
  /// money; this column tracks how much of THIS payment has been returned, so
  /// refunds allocate across payments (each Stripe slice capped at its own
  /// charge) and `charge.refunded` reconciles Stripe's per-charge cumulative
  /// against the right counter. `status` flips to REFUNDED when this reaches
  /// `amount`.
  refundedAmount    Decimal       @default(0) @db.Decimal(10, 2)
  receiptUrl        String?
  /// Stripe's hosted receipt page URL (charge.receipt_url) — the canonical
  /// "stripe_receipt". `stripeReceiptFile` is our durable local snapshot of that
  /// page (downloaded at settlement), so the receipt survives even if Stripe's
  /// URL ever breaks. Both null for manual/offline payments.
  stripeReceiptUrl  String?
  stripeReceiptFile String?
  // Card / payment instrument details captured from the Stripe PaymentIntent
  // at settlement time. `cardBrand` + `cardLast4` appear on the post-payment
  // Invoice PDF and the registration Billing panel so organizers can
  // reconcile. `paymentMethodType` is Stripe's top-level classification
  // (`card`, `bank_transfer`, `sepa_debit`, etc.). `paidAt` is the authoritative
  // settlement timestamp — `createdAt` records when we inserted the row,
  // which drifts from the actual capture moment under webhook retries.
  cardBrand         String?
  cardLast4         String?
  paymentMethodType String?
  paidAt            DateTime?
  metadata          Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  registration Registration?      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  group        RegistrationGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invoice      Invoice?

  @@index([registrationId])
  @@index([groupId])
  @@index([organizationId])
  @@index([stripePaymentId])
}

// ==================== SPEAKER MANAGEMENT ====================

model Speaker {
  id                             String        @id @default(cuid())
  eventId                        String
  userId                         String?
  title                          Title?
  role                           AttendeeRole?
  email                          String
  additionalEmail                String?
  firstName                      String
  lastName                       String
  bio                            String?       @db.Text
  organization                   String?
  jobTitle                       String?
  phone                          String?
  website                        String?
  photo                          String?
  city                           String?
  state                          String?
  zipCode                        String?
  country                        String?
  specialty                      String?
  customSpecialty                String?
  registrationType               String?
  tags                           String[]      @default([])
  socialLinks                    Json          @default("{}")
  status                         SpeakerStatus @default(INVITED)
  // Which public self-signup flow created this submitter-speaker:
  // "abstract" | "proposal" | null (legacy / organizer-added). Drives the
  // submitter surface separation (July 30, 2026 — proposal signups see only
  // Session Proposals, abstract signups only Abstracts; src/lib/submitter-surfaces.ts).
  // First flow wins — never overwritten once set.
  submitterSource                String?
  externalId                     String?
  agreementAcceptedAt            DateTime?
  agreementAcceptedIp            String?
  agreementAcceptedBy            String?
  agreementTextSnapshot          String?       @db.Text
  // Presenter (abstract-author) agreement — DISTINCT from the faculty speaker
  // agreement above. A person can be both a faculty speaker (agreement*) and an
  // abstract author (presenterAgreement*); the two are accepted independently.
  // Per-author, per-event: one acceptance covers all their abstracts. See
  // src/lib/presenter-agreement.ts.
  presenterAgreementAcceptedAt   DateTime?
  presenterAgreementAcceptedIp   String?
  presenterAgreementAcceptedBy   String?
  presenterAgreementTextSnapshot String?       @db.Text
  // Optional pointer to the Registration this speaker was imported from.
  // Null for independent / manually-added / sponsor-suggested speakers (the
  // common case — a speaker need not be a registrant). Set only on the
  // import-registrations path. Enables surfacing the registration's activity
  // on the speaker WITHOUT duplicating it. SetNull so deleting the
  // registration leaves the speaker intact (it's a first-class entity).
  sourceRegistrationId           String?
  // Multi-tenancy Phase 2 (Speaker sweep) — denormalized org for RLS. Nullable
  // (additive/idempotent, no FK), backfilled 1-hop from Event. See
  // prisma/rls/speaker.sql + migration 20260730160000.
  organizationId                 String?
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt

  event                    Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                     User?                     @relation(fields: [userId], references: [id])
  sourceRegistration       Registration?             @relation("SpeakerSourceRegistration", fields: [sourceRegistrationId], references: [id], onDelete: SetNull)
  sessions                 SessionSpeaker[]
  topicSpeakers            TopicSpeaker[]
  abstracts                Abstract[]
  accommodation            Accommodation?
  issuedCertificates       IssuedCertificate[]
  certificateIssueRunItems CertificateIssueRunItem[]
  documents                SpeakerDocument[]
  reimbursement            SpeakerReimbursement?
  travelGrant              TravelGrant?
  profileForm              SpeakerProfileForm?
  sessionProposals         SessionProposal[]

  @@unique([eventId, email])
  @@index([eventId])
  @@index([status])
  @@index([sourceRegistrationId])
  @@index([organizationId])
}

enum SpeakerStatus {
  INVITED
  CONFIRMED
  DECLINED
  CANCELLED
}

enum SpeakerDocumentKind {
  /// The signed agreement copy the organizer received back (wet signature /
  /// emailed PDF). App-enforced ONE per speaker (per event -- speakers are
  /// event-scoped): a new upload replaces the previous one. Deliberately
  /// SEPARATE from Speaker.agreementAcceptedAt (owner decision July 16,
  /// 2026) -- storing the file does not mark the agreement accepted.
  SIGNED_AGREEMENT
  /// Any other per-speaker file: bio doc, CV, COI form scan, etc.
  OTHER
}

/// Per-speaker uploaded documents (July 16, 2026, owner request): the signed
/// agreement copy for future reference + arbitrary attachments (bio doc ...).
/// Files live under /uploads/speaker-docs/{eventId}/; PDF + DOC/DOCX only,
/// magic-byte validated, 10MB cap (see the documents route).
model SpeakerDocument {
  id             String              @id @default(cuid())
  speakerId      String
  kind           SpeakerDocumentKind @default(OTHER)
  url            String
  filename       String
  label          String?
  mimeType       String
  size           Int
  uploadedById   String?
  // Multi-tenancy Phase 2 (Speaker sweep) — denormalized org for RLS. Nullable,
  // backfilled 2-hop via speakerId → Speaker → Event. See prisma/rls/speaker.sql.
  organizationId String?
  createdAt      DateTime            @default(now())

  speaker    Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("SpeakerDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([speakerId])
  @@index([organizationId])
}

model Abstract {
  id               String            @id @default(cuid())
  eventId          String
  // Denormalized tenant key (multi-tenancy Phase 2). Nullable + no FK: stamped
  // from the parent Event at create; backfilled 1-hop. Backs the flat RLS policy.
  organizationId   String?
  speakerId        String
  title            String
  content          String            @db.Text
  trackId          String?
  themeId          String?
  // Optional narrowing under the chosen theme. Required to SUBMIT only when
  // the chosen theme HAS sub-themes (see src/lib/abstract-theme-requirement.ts)
  // — a theme with none submits exactly as before.
  subThemeId       String?
  specialty        String?
  presentationType PresentationType?
  // Co-authors entered by the submitter — array of
  // { name, email, phone, jobTitle, organization, country }. Stored as JSON
  // (contact info only, not accounts). See src/lib/abstract-coauthors.ts.
  coAuthors        Json?
  // Human-readable per-event abstract number (displayed as "A-001" via
  // formatAbstractSerial). Assigned atomically from AbstractSerialCounter at
  // create (src/lib/abstract-serial.ts); existing rows backfilled in createdAt
  // order by migration 20260804120000. Nullable only for blue-green safety —
  // every create path assigns it.
  serialId         Int?
  status           AbstractStatus    @default(SUBMITTED)
  managementToken  String?           @unique
  submittedAt      DateTime          @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  event        Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker      Speaker                    @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  track        Track?                     @relation(fields: [trackId], references: [id])
  theme        AbstractTheme?             @relation(fields: [themeId], references: [id])
  subTheme     AbstractSubTheme?          @relation(fields: [subThemeId], references: [id])
  eventSession EventSession?
  sessionTopic SessionTopic?
  reviewers    AbstractReviewer[]
  submissions  AbstractReviewSubmission[]

  @@unique([eventId, serialId])
  @@index([eventId])
  @@index([speakerId])
  @@index([status])
  @@index([organizationId])
}

model AbstractReviewer {
  id             String               @id @default(cuid())
  abstractId     String
  // Denormalized tenant key (multi-tenancy Phase 2). Nullable + no FK: stamped
  // from the parent Abstract's Event at create; backfilled 2-hop. The reviewer
  // User is org-independent, but this ROW belongs to the abstract's event's org.
  organizationId String?
  userId         String
  assignedAt     DateTime             @default(now())
  assignedById   String
  role           AbstractReviewerRole @default(SECONDARY)
  conflictFlag   Boolean              @default(false)

  abstract    Abstract                   @relation(fields: [abstractId], references: [id], onDelete: Cascade)
  user        User                       @relation("ReviewerOnAbstracts", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy  User                       @relation("AssignedAbstractReviewers", fields: [assignedById], references: [id])
  submissions AbstractReviewSubmission[]

  @@unique([abstractId, userId])
  @@index([abstractId])
  @@index([userId])
  @@index([organizationId])
}

model AbstractReviewSubmission {
  id                 String             @id @default(cuid())
  abstractId         String
  // Denormalized tenant key (multi-tenancy Phase 2). Nullable + no FK: stamped
  // from the parent Abstract's Event at create; backfilled 2-hop. The reviewer
  // User is org-independent, but this ROW belongs to the abstract's event's org.
  organizationId     String?
  reviewerUserId     String
  abstractReviewerId String?
  criteriaScores     Json?
  overallScore       Int?
  reviewNotes        String?            @db.Text
  recommendedFormat  RecommendedFormat?
  confidence         Int?
  submittedAt        DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  abstract         Abstract          @relation(fields: [abstractId], references: [id], onDelete: Cascade)
  reviewer         User              @relation("UserAbstractSubmissions", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  abstractReviewer AbstractReviewer? @relation(fields: [abstractReviewerId], references: [id], onDelete: SetNull)

  @@unique([abstractId, reviewerUserId])
  @@index([abstractId])
  @@index([reviewerUserId])
  @@index([organizationId])
}

/// A narrowing under an AbstractTheme ("Heart Failure" → "Acute", "Chronic").
/// Optional by design: an event may have themes with no sub-themes at all, and
/// those submit exactly as they did before. Where sub-themes DO exist on the
/// chosen theme, picking one is required to submit — the same conditional shape
/// the theme requirement itself uses (src/lib/abstract-theme-requirement.ts).
///
/// eventId is carried alongside themeId so route scoping stays a single bind
/// rather than a join through the parent, matching AbstractTheme; the theme FK
/// cascades, so deleting a theme takes its sub-themes with it.
model AbstractSubTheme {
  id             String   @id @default(cuid())
  themeId        String
  eventId        String
  // Denormalized tenant key (multi-tenancy Phase 2), stamped from Event.
  organizationId String?
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  theme     AbstractTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  abstracts Abstract[]

  @@unique([themeId, name])
  @@index([themeId])
  @@index([eventId])
  @@index([organizationId])
}

model AbstractTheme {
  id             String   @id @default(cuid())
  eventId        String
  // Denormalized tenant key (multi-tenancy Phase 2), stamped from Event; 1-hop.
  organizationId String?
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  abstracts Abstract[]
  subThemes AbstractSubTheme[]

  @@unique([eventId, name])
  @@index([eventId])
  @@index([organizationId])
}

// ── Session proposals (July 30, 2026) ───────────────────────────────────────
// "Abstracts-shaped but for proposing SESSIONS" — deliberately a SEPARATE
// model family (no kind-discriminator on Abstract): Abstract carries review
// machinery (reviewers/submissions/criteria/decisions) that proposals must
// not inherit. v1 is an organizer INBOX only — no review, no accept/reject
// (enum leaves additive room). See docs/SESSION_PROPOSALS_PLAN.md.

enum SessionProposalStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
  // v2 room (add additively when a review workflow lands):
  // UNDER_REVIEW, ACCEPTED, REJECTED
}

model SessionProposal {
  id              String       @id @default(cuid())
  eventId         String
  // Denormalized tenant key, stamped at create — born multi-tenant-ready
  // (LoginEvent/HelpChatQuery convention). App-level org scoping is
  // defence #1; the program-domain RLS sweep picks this up later.
  organizationId  String?
  // The proposer's Speaker facet (SUBMITTER-account linkage, like Abstract).
  speakerId       String
  title           String
  description     String       @db.Text
  themeId         String?
  // Program kinds only (SESSION/WORKSHOP/SYMPOSIUM) — validated in the app
  // via SESSION_TYPE_KIND. Reusing SessionType keeps a future
  // convert-to-session pre-fill free.
  proposedFormat  SessionType?
  durationMinutes Int?
  // Human-readable per-event proposal number (displayed "S-001" via
  // formatSessionProposalSerial). Assigned atomically from
  // SessionProposalSerialCounter at create (src/lib/session-proposal-serial.ts);
  // existing rows backfilled by migration 20260804120000. Nullable only for
  // blue-green safety — every create path assigns it.
  serialId        Int?

  status      SessionProposalStatus @default(SUBMITTED)
  submittedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  event   Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker Speaker               @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  theme   SessionProposalTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@unique([eventId, serialId])
  @@index([eventId, status])
  @@index([organizationId])
  @@index([speakerId])
}

// One row per event holding the last-assigned session-proposal serialId
// (displayed "S-001"). Same atomic upsert+increment pattern as
// RegistrationSerialCounter / AbstractSerialCounter.
model SessionProposalSerialCounter {
  eventId        String  @id
  // Denormalized tenant key — flat-policy convention (see the sibling
  // counters for the INSERT … ON CONFLICT under-RLS rationale).
  organizationId String?
  lastSerial     Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Proposal themes are the event's OWN list (owner: "same like abstract it
// has its own themes") — mirrors AbstractTheme, never shared with it.
model SessionProposalTheme {
  id             String   @id @default(cuid())
  eventId        String
  organizationId String?
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  proposals SessionProposal[]

  @@unique([eventId, name])
  @@index([eventId])
  @@index([organizationId])
}

model ReviewCriterion {
  id             String   @id @default(cuid())
  eventId        String
  // Denormalized tenant key (multi-tenancy Phase 2), stamped from Event; 1-hop.
  organizationId String?
  name           String
  weight         Int
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([organizationId])
}

enum AbstractStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  REVISION_REQUESTED
  WITHDRAWN
}

enum PresentationType {
  ORAL
  POSTER
  ORAL_POSTER
  VIDEO
  WORKSHOP
}

enum RecommendedFormat {
  ORAL
  POSTER
  NEITHER
}

enum AbstractReviewerRole {
  PRIMARY
  SECONDARY
  CONSULTING
}

// ==================== SESSIONS & SCHEDULE ====================

model Track {
  id             String   @id @default(cuid())
  eventId        String
  // Denormalized tenant key (multi-tenancy Phase 2), stamped from Event; 1-hop.
  organizationId String?
  name           String
  description    String?  @db.Text
  color          String   @default("#3B82F6")
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventSessions EventSession[]
  abstracts     Abstract[]

  @@index([eventId])
  @@index([organizationId])
}

model EventSession {
  id             String        @id @default(cuid())
  eventId        String
  // Denormalized tenant key (multi-tenancy Phase 2), stamped from Event; 1-hop.
  organizationId String?
  abstractId     String?       @unique
