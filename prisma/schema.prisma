// The models live in prisma/models/*.prisma (split from this file on Sep 25,
// 2026; the split moved text only, it changed no model):
//   core            organisations, users, events, auth, API keys, MCP OAuth,
//                   event stats, custom roles (PermissionSet)
//   registrations   registration types and tiers, registrations, invoices and
//                   billing accounts, promo codes and sponsors, accommodation
//   program         speakers, abstracts, session proposals, sessions and
//                   tracks, reimbursements, profile forms, travel grants, Zoom
//                   and webinars
//   communications  email templates, scheduled emails, email log,
//                   notifications, device tokens, contacts, media
//   engagement      certificates, surveys, RSVP
//   operations      audit and login logs, system log, public docs, help
//                   queries, agent runs, import log, worker jobs, DR archive
//   crm, hr, procurement   the three bounded modules, one file each
// Prisma reads the whole prisma/ folder because package.json sets
// "prisma": { "schema": "prisma" }. This file keeps the generator and the
// datasource so prisma/migrations stays beside the datasource, where
// `migrate deploy` looks. Tools that read the schema TEXT use
// prisma/schema-text.ts, never this file alone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

