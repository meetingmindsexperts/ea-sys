// ==================== EMAIL LOG (per-send audit) ====================

enum EmailLogEntityType {
  REGISTRATION
  SPEAKER
  CONTACT
  USER
  OTHER
}

enum EmailLogStatus {
  SENT
  FAILED
}

model EmailLog {
  id                String              @id @default(cuid())
  organizationId    String?
  eventId           String?
  entityType        EmailLogEntityType?
  entityId          String?
  to                String
  cc                String?
  bcc               String?
  subject           String
  templateSlug      String?
  provider          String
  providerMessageId String?
  status            EmailLogStatus
  errorMessage      String?             @db.Text
  // Final rendered HTML of the sent email — audit copy, populated only for
  // opt-in senders (certificate deliveries; see EmailLogContext.storeBody).
  htmlBody          String?             @db.Text
  // Filenames of the attachments that rode on this send (e.g. the paid
  // invoice + receipt PDFs on a payment confirmation). NAMES ONLY, never the
  // bytes — the documents themselves stay re-downloadable from their own
  // surfaces. Captured centrally in sendEmail, so every sender is covered.
  // Empty for rows logged before Aug 3, 2026 (not backfillable).
  attachmentNames   String[]            @default([])
  triggeredByUserId String?
  createdAt         DateTime            @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  triggeredBy  User?         @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([eventId])
  @@index([to])
  @@index([createdAt])
}

// ── RSVP (customizable) ────────────────────────────────────────────
// An event runs N INDEPENDENT RSVPs (`RsvpCampaign`): a gala dinner, a set
// of parallel workshops, a site visit. Each campaign owns its own items AND
// its own invite list, which is the whole point — the dinner audience and
// the workshop audience are different people.
//
// Was "Dinner RSVP" (July 2026), where the invite was EVENT-level with
// @@unique([eventId, inviteeEmail]), so an event could only ever have ONE
// audience and one link covering every dinner. Generalized August 2026.
//
// ⚠ The three original tables keep their SQL names via @@map / @map. A real
// ALTER TABLE ... RENAME is not blue/green safe: migrations run BEFORE the
// container swap, so the still-live old container would query a table that
// no longer exists. Same call the Aug 13 supporting-document round made for
// Registration's columns. Cost: the physical table is still "RsvpDinner"
// while holding workshops. Documented, deliberate.
//
// Docs: docs/RSVP.md.

enum RsvpStatus {
  PENDING // invited, not yet responded
  RESPONDED // submitted the form (attending ≥0 items)
}

/// How an invitee answers a campaign: tick any of the items, or pick exactly
/// one. SINGLE is enforced server-side, not just by the radio group.
enum RsvpSelectionMode {
  SINGLE // parallel workshop tracks — pick one
  MULTI // dinners across several nights — tick any
}

model RsvpCampaign {
  id             String            @id @default(cuid())
  eventId        String
  // Denormalized tenant key (Domain #15). Nullable, no FK; stamped at create
  // from the event. Drives the RLS policy in prisma/rls/rsvp.sql.
  organizationId String?
  name           String
  description    String?           @db.Text
  selectionMode  RsvpSelectionMode @default(MULTI)
  // Guests and dietary are INDEPENDENT, deliberately not one `kind` enum: a
  // site visit collects dietary (packed lunch) but no guests; a workshop
  // takes neither. Collapsing them makes those cases unrepresentable.
  allowGuests    Boolean           @default(false)
  collectDietary Boolean           @default(false)
  isActive       Boolean           @default(true)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items   RsvpItem[]
  invites RsvpInvite[]

  @@index([eventId])
  @@index([organizationId])
}

/// One thing an invitee can say yes to: a dinner, a workshop slot, a tour.
model RsvpItem {
  id             String    @id @default(cuid())
  campaignId     String
  // Denormalized from the campaign. Kept so the existing event-scoped indexes
  // and tenancy backfill keep working; ALWAYS set from campaign.eventId, never
  // independently.
  eventId        String
  organizationId String?
  name           String
  startsAt       DateTime  @map("dinnerAt")
  location       String?
  description    String?   @db.Text
  rsvpDeadline   DateTime?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign  RsvpCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses RsvpResponse[]

  @@index([campaignId])
  @@index([eventId])
  @@index([organizationId])
  @@map("RsvpDinner")
}

model RsvpInvite {
  id             String     @id @default(cuid())
  campaignId     String
  // Denormalized from the campaign (see RsvpItem.eventId).
  eventId        String
  organizationId String?
  token          String     @unique
  inviteeName    String
  inviteeEmail   String
  // Soft references (no FK) to the person's Registration/Speaker facet,
  // if the invitee was picked from an existing record. The invite keeps
  // its own name/email snapshot, so a dangling id is harmless. Submitters
  // are Speaker rows, so they arrive via speakerId.
  registrationId String?
  speakerId      String?
  dietary        String?    @db.Text
  status         RsvpStatus @default(PENDING)
  respondedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  campaign  RsvpCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses RsvpResponse[]

  // THE load-bearing line. Was @@unique([eventId, inviteeEmail]), which made a
  // second audience on one event impossible — adding someone to the workshop
  // list collided with their dinner invite.
  @@unique([campaignId, inviteeEmail])
  @@index([campaignId])
  @@index([campaignId, status])
  @@index([eventId])
  @@index([organizationId])
}

model RsvpResponse {
  id             String   @id @default(cuid())
  inviteId       String
  itemId         String   @map("dinnerId")
  organizationId String?
  attending      Boolean  @default(false)
  guestCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invite RsvpInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  item   RsvpItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([inviteId, itemId])
  @@index([itemId])
  @@index([inviteId])
  @@index([organizationId])
  @@map("RsvpDinnerResponse")
}

// ── Speaker reimbursement (July 20, 2026) ──────────────────────────
// Web replacement for the paper "Speaker / Faculty Reimbursement Form"
// (bank wire transfer request). One reimbursement per speaker per event
// (speakerId is unique; Speaker is already event-scoped). The speaker
// fills it via a personalized token link (/e/{slug}/reimbursement/{token})
// — no login. v1 is SUBMISSION-ONLY (owner decision): PENDING → SUBMITTED;
// approval/payment tracking stays outside the system. Submitted forms are
// LOCKED; an organizer "Reopen for edits" flips back to PENDING (audited).
//
// PII note: passportNumber + bankDetails are wire-transfer data — the most
// sensitive fields in the system. All dashboard routes are gated to
// SUPER_ADMIN/ADMIN/ORGANIZER via denyReviewer (its restricted set is
// exactly the excluded population — owner decision July 20). Uploaded
// documents (passport scans, receipts) live under
// public/uploads/reimbursements/ so they ride the persistent Docker volume
// + hourly DR sync, but the public /uploads catch-all BLOCKS that prefix —
// files stream only through the authed documents route.

enum ReimbursementStatus {
  PENDING // invited / reopened — the speaker can (re)submit
  SUBMITTED // locked; organizer may reopen
}

model SpeakerReimbursement {
  id             String              @id @default(cuid())
  eventId        String
  /// Multi-tenancy Phase-2 (Domain #17, Aug 3 2026): denormalized tenant key
  /// (nullable, no FK), backfilled 1-hop from Event; the dashboard add-speakers
  /// createMany stamps it. Backs prisma/rls/reimbursement.sql (platform-only).
  organizationId String?
  speakerId      String              @unique
  token          String              @unique
  status         ReimbursementStatus @default(PENDING)

  // Section B — speaker/faculty details (prefilled from Speaker, editable
  // by the speaker; snapshot on this row so a later Speaker edit doesn't
  // rewrite what was signed).
  fullName       String? // as on passport
  designation    String?
  institution    String?
  country        String?
  email          String?
  phone          String?
  nationality    String?
  passportNumber String?
  roleAtEvent    String?

  // Section C — claim lines: [{ item, currency, amount }] with
  // item ∈ SPEAKER_FEE|FLIGHT|HOTEL|TRANSPORT|OTHER, currency ∈ USD|AED|SAR.
  claimLines Json?

  // Section D — bank transfer details: { beneficiaryName, beneficiaryAddress,
  // bankName, bankAddress, bankCountry, accountNumber, iban, swift,
  // routingNumber, sortCode, intermediaryBank }. Never queried, only
  // displayed to staff — hence one JSON blob, not columns.
  bankDetails Json?

  // Section F — declaration (typed-name e-signature, same shape as the
  // speaker-agreement acceptance trail).
  signedName  String?
  submittedAt DateTime?
  submittedIp String?

  // Soft ref (no FK) to the staff user who created the invite — the audit
  // log is the authoritative trail, same pattern as RsvpInvite's soft refs.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker   Speaker                        @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  documents SpeakerReimbursementDocument[]

  @@index([eventId])
  @@index([eventId, status])
  @@index([organizationId])
}

model SpeakerReimbursementDocument {
  id              String   @id @default(cuid())
  reimbursementId String
  /// Multi-tenancy Phase-2 (Domain #17): 2-hop tenant key via
  /// SpeakerReimbursement; the public upload stamps it from the loaded row.
  organizationId  String?
  // PASSPORT | FLIGHT_RECEIPT | HOTEL_INVOICE | TRANSPORT_RECEIPT | OTHER —
  // a string (not an enum) so adding a kind never needs a migration.
  kind            String
  // Path under /uploads/reimbursements/{eventId}/ — NOT publicly served
  // (blocked in the /uploads catch-all); streams via the authed route only.
  url             String
  filename        String
  mimeType        String
  size            Int
  createdAt       DateTime @default(now())

  reimbursement SpeakerReimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@index([reimbursementId])
  @@index([organizationId])
}

// ── Speaker profile form (Aug 4, 2026) ─────────────────────────────
// Public token form where a speaker submits their own PHOTO (→ Speaker.photo),
// a PASSPORT photocopy (required) + COVER LETTER (optional) — both stored as
// SpeakerDocument rows (kind OTHER with fixed labels) so they surface on the
// existing Documents card — and their BIO (→ Speaker.bio). The organizer
// mints + emails the personalized link from the speaker page
// (speaker-profile-form-request template). Mirrors the SpeakerReimbursement
// token pattern: plaintext unique token (dashboard re-displays the link),
// PENDING → SUBMITTED conditional claim, organizer may reopen (audited).
// Uploaded files live under /uploads/speaker-docs/{eventId}/ which is
// BLOCKED in the public /uploads catch-all (passport = sensitive PII) —
// staff stream them via the authed documents file route.

enum SpeakerProfileFormStatus {
  PENDING // link minted / reopened — the speaker can (re)submit
  SUBMITTED // locked; organizer may reopen
}

model SpeakerProfileForm {
  id             String                   @id @default(cuid())
  eventId        String
  /// Denormalized tenant key (sweep convention): nullable, no FK, stamped by
  /// every writer from the event's org.
  organizationId String?
  speakerId      String                   @unique
  token          String                   @unique
  status         SpeakerProfileFormStatus @default(PENDING)
  submittedAt    DateTime?
  submittedIp    String?
  // Soft ref (no FK) to the staff user who minted the link — the audit log
  // is the authoritative trail (RsvpInvite soft-ref pattern).
  createdById    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([organizationId])
}

// ── Worker job runs ────────────────────────────────────────────────
// One row per background-worker tick (written by withJobLock). Powers
// the Infra / Ops "Cron / Jobs" card — did each cron run, when, did it
// fail. Successful ticks log at debug (skipped by SystemLog), so this
// persisted record is the reliable "last good run" source. Pruned to
// 14 days by the hourly oauth-cleanup job. Docs: docs/INFRA_OPS.md.

enum JobRunStatus {
  OK
  FAILED
}

/// One row per refund ATTEMPT, persisted BEFORE the Stripe call (crash-safety
/// for money movement — review finding H4/H5, July 10 2026). The row id is the
/// Stripe idempotency key (`refund-attempt-{id}`) and rides in the Stripe
/// refund's metadata, so a crashed/ambiguous attempt can always be verified
/// against Stripe and reconciled by the sweep in
/// src/lib/refund-reconciliation.ts:
///   PENDING   — booked in refundedAmount; Stripe call in flight (or process
///               died before it — the sweep resolves which).
///   SUCCEEDED — money moved (or manual refund recorded).
///   FAILED    — Stripe refused and the booking was rolled back.
///   UNKNOWN   — Stripe errored AND verification failed; booking kept, sweep
///               retries verification until it can resolve.
model RefundAttempt {
  id                    String              @id @default(cuid())
  registrationId        String
  // Denormalized tenant key (multi-tenancy Phase-2 Registration-core sweep,
  // 2 hops from Event via Registration; paymentId has no FK so Registration
  // is this table's only real parentage) — see Registration.organizationId.
  organizationId        String?
  registration          Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  /// Payment row targeted (plain column, no FK — audit/ops record).
  paymentId             String?
  /// Stripe payment intent the refund runs against; null for manual/offline.
  stripePaymentIntentId String?
  amount                Decimal             @db.Decimal(10, 2)
  refundedBefore        Decimal             @db.Decimal(10, 2)
  refundedAfter         Decimal             @db.Decimal(10, 2)
  /// Whether the registration was flipped to REFUNDED by this attempt's
  /// booking — the sweep needs it to roll the flip back on a failed attempt.
  flippedToRefunded     Boolean             @default(false)
  kind                  String // "stripe" | "manual"
  status                RefundAttemptStatus @default(PENDING)
  stripeRefundId        String?
  error                 String?
  source                String?
  issuedByUserId        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([registrationId])
  @@index([organizationId])
  @@index([status, createdAt])
}

enum RefundAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
}

model JobRun {
  id         String       @id @default(cuid())
  job        String
  startedAt  DateTime
  finishedAt DateTime
  status     JobRunStatus
  durationMs Int
  error      String?      @db.Text
  createdAt  DateTime     @default(now())

  @@index([job, startedAt])
  @@index([startedAt])
}

/// One row per background job — the "who is running this right now" sheet.
///
/// Replaces the session-scoped `pg_try_advisory_lock` the worker used until
/// 2026-08-10. That lock has to be RELEASED by the same database connection
/// that TOOK it, and Prisma's pool hands out whichever connection is free — so
/// the release routinely landed on a connection that never held the lock, the
/// lock leaked, and every subsequent tick skipped. Measured on prod:
/// `scheduled-emails` ran 7 times in 30 minutes instead of 30, with locks
/// observably held by connections sitting idle.
///
/// A lease fixes that structurally: claiming is ONE atomic statement
/// (`INSERT … ON CONFLICT DO UPDATE … WHERE` expired-or-free), so it does not
/// matter which connection executes it, and `lockedUntil` means a lease whose
/// holder died **expires by itself** rather than wedging the job forever.
///
/// Deliberately has NO organizationId: this is platform infrastructure, not
/// tenant data — the worker is a single process serving every tenant, and a
/// per-tenant lease would let one tenant's stuck job block another's.
model JobLease {
  /// Job name (matches worker/jobs/*.ts JOB_NAME). One row per job.
  job         String    @id
  /// Random per-tick token. Every mutation is conditional on this, so a tick
  /// whose lease already expired can never release or extend its successor's.
  owner       String?
  /// Lease expiry. NULL = free. Past = expired and reclaimable.
  lockedUntil DateTime?
  acquiredAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
}

// ═══════════════════════════════════════════════════════════════════════════
// CRM MODULE
//
// Bounded module — see docs/CRM_MODULE_PLAN.md §7.0 ("independent module,
// shared runtime"). Every model is Crm*-prefixed so the schema reads as one
// distinct block; code lives under src/crm/, routes under /api/crm/*, pages
// under /(dashboard)/crm/*. src/crm/ may import core; core NEVER imports
// src/crm/ (enforced by an ESLint import-boundary rule, not by discipline).
//
// Primary use case (locked, §9): SPONSOR / EXHIBITOR SALES PIPELINE. The
// CrmDeal.eventId link is the whole point — "Abbott → BRIDGES 2026 → Gold →
// $40k → Negotiation" is a join no off-the-shelf CRM can do against our data.
// ═══════════════════════════════════════════════════════════════════════════

enum CrmDealStatus {
  OPEN
  WON
  LOST
}

enum CrmTaskStatus {
  OPEN
  DONE
}

/// The line of business a deal sits in — a simple CATEGORY, NOT a separate
/// pipeline (owner decision, July 28 2026). Every deal still shares the one
/// org-configurable stage set; this only classifies/filters. Nullable so
/// imports + legacy deals need no backfill. Additive-only: new values later are
/// an `ALTER TYPE … ADD VALUE`, the house pattern.
enum CrmDealPipeline {
  CORPORATE
  CONFERENCE
}

/// Contact lifecycle (locked, §9). Nullable on Contact — existing contacts stay
/// null, so this is additive and needs no backfill. NOTE: an account lapses, a
/// person doesn't — "lapsed sponsor" is deliberately NOT a value here; it is a
/// deal/company query ("won last year, nothing open this year").
enum CrmLifecycleStage {
  LEAD
  ENGAGED
  CUSTOMER
  CHAMPION
}

/// Where the sales CONVERSATION stands (Freshsales-style). Distinct from
/// CrmLifecycleStage, which is relationship depth — a CHAMPION can still be in
/// NEGOTIATION on this year's deal. Nullable so existing rows need no backfill;
/// the service defaults new contacts to NEW.
enum CrmContactStatus {
  NEW
  CONTACTED
  INTERESTED
  QUALIFIED
  NEGOTIATION
  WON
  LOST
  UNQUALIFIED
}

enum CrmActivityType {
  NOTE
  CALL
  MEETING
}

/// Which CRM entity a CrmActivity row is about. Polymorphic (entityType +
/// entityId) rather than four FK columns — one timeline table across all four
/// record types, same shape as the core AuditLog.
enum CrmActivityEntity {
  DEAL
  COMPANY
  CONTACT
  TASK
}

/// The CRM change log — the "detailed activity log" surfaced in every detail
/// sheet. SYSTEM-generated (create / edit-with-field-diffs / archive / restore /
/// stage-move / won / lost / contact-linked …), distinct from CrmNote which is a
/// human-written note/call/meeting.
///
/// This is the CRM's OWN audit store, not the core AuditLog: it is org-scoped
/// (trivial tenant-safe reads), it stores before→after field diffs purpose-built
/// for a timeline, and — critically — it is actually READ in the UI, which the
/// core AuditLog's CRM rows never were. One writer feeds it (recordCrmActivity),
/// so the trail can't drift between callers.
model CrmActivity {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entityType CrmActivityEntity
  entityId   String

  /// CREATE | UPDATE | ARCHIVE | RESTORE | STAGE_MOVE | WON | LOST |
  /// CONTACT_ADDED | CONTACT_REMOVED | COMPLETE | REOPEN | LINK_EVENT_CONTACT | …
  action  String
  /// { source, changes?: { field: { from, to } }, ...snapshot }. `dealValue` keys
  /// here are stripped for money-blind callers by the same FINANCIAL_KEYS redactor
  /// the board uses.
  changes Json?

  /// Nullable + SetNull: an activity row outlives the user who caused it (a rep
  /// leaves, their account is deleted — the trail must not vanish with them).
  actorId String?
  actor   User?   @relation("CrmActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
}

/// In-app CRM notifications — the bell in the CRM shell. DELIBERATELY SEPARATE
/// from the core `Notification` model (owner decision, July 17): the event
/// platform's bell must never mix sponsorship-pipeline traffic into an event
/// organizer's feed, and core never reads Crm* tables (the module boundary).
/// One writer feeds it (`notifyCrmUser` in crm-notifications.ts) — the same
/// one-writer rule as CrmActivity. In-app only: no email (the reminders worker
/// already emails task owners) and no push.
///
/// `type` is a string, not an enum (the core Notification.type + the
/// CrmActivity.action precedent — a new kind of notification must not need a
/// migration): DEAL_ASSIGNED | DEAL_STAGE_MOVED | DEAL_WON | DEAL_LOST |
/// TASK_ASSIGNED | TASK_DUE.
///
/// Title/message deliberately carry NO deal money. Recipients are always staff
/// (only staff own deals/tasks), but keeping money out of the payload means the
/// FINANCIAL_KEYS redaction question never arises for this table.
model CrmNotification {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The recipient. Cascade — a deleted user's notification pile goes with them
  /// (unlike CrmActivity's SetNull: a notification is FOR a person and worthless
  /// without them; an activity row is ABOUT a record and must outlive its actor).
  userId String
  user   User   @relation("CrmNotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  type    String
  title   String
  message String
  /// In-app path to navigate to on click (e.g. /crm/deals/{id}).
  link    String?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

/// Reusable CRM email templates — the org's editable starting points for the
/// sponsor blast + per-deal send. Org-wide shared (any CRM writer edits the same
/// set); seeded on first use from the built-in constants. Soft-delete via
/// archivedAt (a picker lists non-archived; the send substitutes {{tokens}} in the
/// body at send time — the template just pre-fills subject + body).
model CrmEmailTemplate {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  subject String
  /// HTML body fragment (no greeting/signature — the send pipeline adds those).
  body    String @db.Text

  sortOrder  Int       @default(0)
  archivedAt DateTime?

  createdById String?
  createdBy   User?   @relation("CrmEmailTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Makes the first-use seed race-safe (CRM review H1): with the unique in place,
  // the seed's createMany({ skipDuplicates: true }) actually skips when two
  // concurrent first-loads both pass the count===0 fast-path — without it,
  // skipDuplicates is a no-op and both writers insert the full template set.
  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
}

/// In-house vs out-sourced — the sourcing axis, distinct from the functional category.
enum CrmProductSource {
  IN_HOUSE
  OUTSOURCED
}

/// The org's product/service catalog (seeded from CrmProductSeed, then editable).
/// `category` is the FUNCTIONAL group (Content, Sponsorship, …) — the deal-facing
/// category; `source` is the In-House/Out-Sourced axis. `price` is the catalog list
/// price (AED) that pre-fills a deal line item — the line price is set on the deal.
model CrmProduct {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  sku              String?
  category         String
  source           CrmProductSource @default(IN_HOUSE)
  price            Decimal          @default(0) @db.Decimal(12, 2)
  currency         String           @default("AED")
  priceIncludesTax Boolean          @default(false)

  sortOrder  Int       @default(0)
  archivedAt DateTime?

  createdById String?
  createdBy   User?   @relation("CrmProductCreator", fields: [createdById], references: [id], onDelete: SetNull)

  dealLines CrmDealProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique SKU per org — makes the seed idempotent under a concurrent first-load
  // (the second seed's createMany skipDuplicates skips the SKU-collisions) AND stops
  // manual duplicate SKUs. `sku` is nullable, so Postgres treats multiple NULL-SKU
  // products as distinct — manual products without a SKU are unaffected.
  @@unique([organizationId, sku])
  @@index([organizationId, category, sortOrder])
}

/// A product on a deal — a line item. The deal's Value stays MANUAL; this is the
/// itemization (products total is informational). `unitPrice` is set on the deal
/// (pre-filled from the catalog list price). name/category/sku are snapshotted at
/// add-time so a later catalog edit never rewrites a deal's line.
model CrmDealProduct {
  id             String  @id @default(cuid())
  // Multi-tenant prep (July 23, 2026): junction rows carry the org directly so a
  // future RLS policy is a cheap single-column predicate instead of a join through
  // the parent deal. Nullable ONLY for blue-green safety on the shared prod DB
  // (an old container mid-swap still inserts without it); always written by the
  // app and backfilled by migration — tighten to NOT NULL on the platform silo.
  organizationId String?
  dealId         String
  deal           CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  crmProductId String?
  crmProduct   CrmProduct? @relation(fields: [crmProductId], references: [id], onDelete: SetNull)

  productName String
  category    String
  sku         String?

  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  currency  String  @default("AED")
  quantity  Int     @default(1)

  createdAt DateTime @default(now())

  // One line per catalog product per deal (review R2-H2): the
  // PRODUCT_ALREADY_ON_DEAL check in addDealProduct is check-then-act, so this
  // unique is the backstop that makes concurrent duplicate adds unrepresentable
  // (the loser's P2002 maps back to PRODUCT_ALREADY_ON_DEAL). Rows whose
  // catalog product was deleted (crmProductId NULL via SetNull) stay exempt —
  // Postgres treats NULLs as distinct in a unique index. The unique's leftmost
  // column covers dealId lookups, so no separate @@index([dealId]).
  @@unique([dealId, crmProductId])
  @@index([crmProductId])
  @@index([organizationId])
}

/// Which slot a deal document fills. PROSPECTUS is one-per-deal (app-enforced
/// replace + a partial-unique SQL backstop, the SpeakerDocument pattern) — the
/// file the Email dialog offers to attach; QUOTE rows are GENERATED quote PDFs
/// (org-sequential number via CrmQuoteCounter, every generation kept as
/// history); OTHER is an open list (contract drafts, rate cards).
enum CrmDealDocumentKind {
  PROSPECTUS
  QUOTE
  OTHER
}

/// Org-sequential quote numbering (Q-0001…) — the atomic upsert+increment
/// counter pattern (RegistrationSerialCounter / CertificateSerialCounter), so
/// two reps generating at once can never mint the same number.
model CrmQuoteCounter {
  organizationId String @id
  lastNumber     Int    @default(0)
}

/// Files held BY a deal — the sponsorship prospectus + supporting documents.
/// PDF-only (owner decision, July 21 2026): what goes to a sponsor is a PDF.
/// Stored under public/uploads/crm-deal-docs/{dealId}/ — marketing collateral,
/// not PII, so the public /uploads catch-all may serve it (unlike
/// reimbursement documents, which are blocked there).
model CrmDealDocument {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealId String
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  kind     CrmDealDocumentKind @default(OTHER)
  url      String
  filename String
  label    String?
  mimeType String
  size     Int

  uploadedById String?
  uploadedBy   User?   @relation("CrmDealDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([dealId])
  @@index([organizationId])
}

enum CrmEmailDirection {
  INBOUND
  OUTBOUND
}

/// CRM email inbox (July 23, 2026) — one conversation with one external person.
/// Minted on every CRM outbound send; the unique `replyToken` becomes the
/// tokenized Reply-To local part (`<token>@$CRM_REPLY_DOMAIN`), so an inbound
/// reply resolves to its thread exactly — no fuzzy matching. Contact/deal FKs
/// are SetNull so the correspondence history survives a contact purge or deal
/// deletion; `counterpartyEmail/Name` are snapshots for the same reason.
model CrmEmailThread {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealId String?
  deal   CrmDeal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  crmContactId String?
  crmContact   CrmContact? @relation(fields: [crmContactId], references: [id], onDelete: SetNull)

  subject           String
  replyToken        String  @unique
  counterpartyEmail String
  counterpartyName  String?

  /// Internal addresses to loop in when a reply arrives on this thread — the
  /// outbound send's CC + BCC (which includes the sender's own "copy to me"
  /// address). The inbound worker forward-copies replies to these + the deal
  /// owner + the partnerships shared mailbox, so a conversation stays visible in
  /// Outlook, not just the CRM inbox. Captured per-send (each CRM send is a
  /// fresh thread); the partnerships address is added at forward time (a runtime
  /// constant), never stored here.
  notifyEmails String[] @default([])

  /// Shared-inbox semantics: set on inbound arrival, cleared when anyone opens
  /// the thread (owner decision — one bulk inbox, not per-user read state).
  hasUnread     Boolean   @default(false)
  lastMessageAt DateTime  @default(now())
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())

  /// Token lifecycle (review M1): the reply token is a durable credential in
  /// every outbound Reply-To, so it must not be an eternal injection channel.
  /// `expiresAt` rolls forward on every message (mint/send/inbound) — a leaked
  /// token to a dormant thread stops accepting mail after the window of silence.
  /// `revokedAt` is explicit kill (set when the deal is archived, cleared on
  /// restore). The worker refuses inbound to a revoked or expired thread.
  expiresAt DateTime?
  revokedAt DateTime?

  messages CrmEmailMessage[]

  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([dealId])
  @@index([crmContactId])
}

/// Persistent double-submit guard for a CRM email BLAST (sponsor prospectus /
/// deal email). The send is synchronous and can fan out to the whole audience,
/// so a gateway-timeout-then-re-click must not re-email everyone. One row per
/// (org, content-hash) claim; a second identical send inside the dedup window
/// is refused. DB-backed (not the in-memory rate limiter) so it survives a
/// blue-green swap and holds across containers. Rows are ephemeral — pruned
/// opportunistically (claims older than ~1h) on each send (CRM review M2).
model CrmEmailSendClaim {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dedupHash      String
  claimedAt      DateTime     @default(now())

  @@unique([organizationId, dedupHash])
  @@index([organizationId, claimedAt])
}

model CrmEmailMessage {
  id             String @id @default(cuid())
  organizationId String

  threadId String
  thread   CrmEmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  direction CrmEmailDirection

  fromEmail String
  fromName  String?
  subject   String?
  textBody  String? @db.Text
  /// Outbound: the rendered branded HTML actually sent. Inbound: the sender's
  /// raw HTML part — UNTRUSTED, rendered only inside a sandboxed iframe.
  htmlBody  String? @db.Text

  /// RFC Message-ID of this message (threading headers for the reply composer).
  messageId         String?
  inReplyTo         String?
  /// Outbound: provider (SES) message id. Inbound: S3 key of the raw MIME.
  /// s3Key is UNIQUE (review H2): it's the idempotency key for the inbound
  /// drain, so two racing ticks can't both file the same email (the loser hits
  /// P2002 before any forward). NULLs (outbound rows) are distinct in Postgres.
  providerMessageId String?
  s3Key             String? @unique

  /// Inbound only: [{ filename, size, mimeType, path }] under the private
  /// crm-email-attachments upload prefix (blocked on the public /uploads route).
  attachments      Json?
  /// SES receipt verdicts (inbound): "PASS"/"FAIL"/etc. — FAIL is quarantined
  /// before it ever gets a row, so this is informational.
  spamVerdict      String?
  /// Inbound only (review H1): true when the sender could not be verified
  /// against the thread's counterparty (domain mismatch / DMARC fail). The
  /// message is stored + shown with a warning badge, but the auto-forward to
  /// the deal owner is SUPPRESSED — a spoofed "reply" must not reach a real
  /// mailbox under our branding (BEC / changed-bank-details fraud).
  unverifiedSender Boolean @default(false)

  sentByUserId String?
  sentBy       User?   @relation("CrmEmailMessageSender", fields: [sentByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([organizationId])
}

/// First-class Account. Today Contact.organization is a free-text string, which
/// is why "Cleveland Clinic" and "Cleveland Clinic Foundation" are two things.
///
/// `nameKey` is the trimmed+lowercased name and carries the unique index;
/// `name` is the display form. This is deliberate: the contacts review (H2,
/// July 14 2026) found that a CASE-SENSITIVE unique index plus writers that
/// don't normalize mints two rows for one entity — and then the downstream
/// sync silently mirrors only one of the pair. Normalizing in the index rather
/// than trusting every writer to lowercase makes that bug unrepresentable.
model CrmCompany {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  nameKey  String // trimmed + lowercased — the dedup key, see note above
  industry String? // pharma | hospital | society | agency | …
  website  String?
  phone    String?
  country  String?
  city     String?
  notes    String? @db.Text

  /// Free-form tags ("multi-year", "key-account", "warm"), same shape as
  /// CrmContact.tags — for the account owner's own grouping + list filtering.
  tags String[] @default([])

  /// Set when created via fuzzy match (e.g. "Cleveland Clinic" vs "Cleveland
  /// Clinic Foundation") so finance can merge later. Advisory — never blocks.
  needsReview Boolean @default(false)

  contacts CrmContact[]
  deals    CrmDeal[]
  tasks    CrmTask[]
  notes_   CrmNote[]

  /// External-system provenance (Freshsales CSV import). `externalId` is the
  /// source system's record id — the upsert key that makes RE-importing a fresh
  /// export converge instead of duplicate. `lastImportedAt` powers the conflict
  /// rule: a row edited in EA-SYS after its last import wins over the CSV.
  externalSource String?
  externalId     String?
  lastImportedAt DateTime?

  /// Soft delete. Set = archived (hidden from lists/board/reports, restorable).
  /// We never hard-delete a CRM record: the row and its CrmActivity trail survive
  /// so "who archived this account, and when" stays answerable.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, nameKey])
  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId])
}

/// Org-configurable pipeline (locked, §9). A TABLE, not an enum — sales will
/// change its mind, and that must be a row edit rather than a migration against
/// a live production DB. Seeded per-org with:
///   Prospect → Contacted → Proposal → Negotiation → Won → Lost
/// The two terminal stages are flagged isTerminal.
///
/// SECURITY: stageId becomes user-supplied input on every deal write and every
/// kanban drag, so it is an IDOR surface — always bind it to the caller's org
/// before use.
model CrmPipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  sortOrder  Int
  isTerminal Boolean @default(false)

  /// The business outcome a TERMINAL stage implies (CRM review H3). Stored on the
  /// row, NOT derived from the stage name, so renaming "Won" can never silently
  /// stop drag-to-close/closeDeal() from closing deals. Null on open stages, and
  /// on a custom terminal stage the org hasn't mapped — deals dragged into an
  /// unmapped terminal stage keep their current status rather than having an
  /// outcome invented from the column name.
  terminalOutcome CrmStageOutcome?

  /// Deals are Restrict-protected: you cannot delete a stage that still holds
  /// deals — move them first. Silently vaporising a pipeline column's contents
  /// is not a thing we let an errant click do.
  deals CrmDeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stage names are load-bearing lookup keys (the board, the reconcile planner) —
  // and the unique is what makes the seed's createMany skipDuplicates actually
  // skip under a concurrent first-load (CRM review H1). Case-sensitive; the seed
  // always writes identical strings, so both racers collide as intended.
  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
}

/// The outcome a terminal CrmPipelineStage maps a deal to. See
/// CrmPipelineStage.terminalOutcome.
enum CrmStageOutcome {
  WON
  LOST
}

/// A sponsorship / exhibitor deal.
///
/// FK deletion policy is chosen so that MONEY HISTORY SURVIVES:
///   company  → Restrict  (can't delete an account that has deals; reassign or
///                         close them first — the BillingAccount precedent)
///   stage    → Restrict  (see CrmPipelineStage)
///   event    → SetNull   (event deletion is already a heavy cascade; the deal
///                         is revenue history and must outlive it)
///   contact  → SetNull
///   owner    → SetNull   (see the ownerId note below)
///
/// Org-configurable deal TYPE — the admin-editable business-line list ("Conference
/// Management", "Sponsorship Inquiry", "Industry Symposium", …) shown as a dropdown
/// on the deal and managed in Settings → CRM → Deal Types. Same managed-list shape
/// as CrmPipelineStage (per-org, named, ordered, soft-deletable) minus the terminal/
/// outcome semantics — a deal type is a pure classifier, it does not drive the board.
/// Soft delete via archivedAt (hidden from the picker; existing deals keep resolving
/// the name); a hard delete SetNulls the deal's dealTypeId (never blocks a delete).
model CrmDealType {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int

  /// Soft delete — hidden from the picker + the board filter, but the row stays so
  /// deals that reference it still render its name (same rule as archived CRM
  /// records elsewhere).
  archivedAt DateTime?

  deals CrmDeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Name is the dedup key — backs the seed's createMany skipDuplicates under a
  // concurrent first-load (same reasoning as CrmPipelineStage).
  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
}

/// `ownerId` is NULLABLE and SetNull, deviating from the original blueprint
/// sketch (which had it required). Reason: users DO get deleted here (temp
/// accounts are a routine flow). A required owner with Restrict would make
/// deleting a deal-owning organizer fail with a raw P2003 from an unrelated
/// core route — and teaching that core route about CRM would violate the
/// one-way import rule. An unowned deal is visible, recoverable and
/// reassignable; a blocked user-delete or an orphaned FK is neither.
model CrmDeal {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String // "Abbott — BRIDGES 2026 Gold"

  companyId String?
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /// A deal involves SEVERAL people at the account — the rep, marketing,
  /// procurement. A single contactId cannot model that, so the link is a join
  /// table carrying each person's role on this deal.
  contacts CrmDealContact[]

  /// THE differentiator — the deal↔event join (§9 decision 1).
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  /// Finance-gated: `dealValue` is in FINANCIAL_KEYS so the existing
  /// redactFinancialFields() machinery hides it from MEMBER unchanged (§9 d4).
  ///
  /// Named `dealValue`, NOT `value`, deliberately: redactFinancialFields() is a
  /// recursive strip-by-key-name, and `value` already occurs in unrelated
  /// payload shapes (survey free-text answers). A bare `value` in FINANCIAL_KEYS
  /// would blank those for MEMBER — a new feature breaking a shipped one.
  dealValue Decimal? @db.Decimal(12, 2)
  currency  String   @default("USD")

  stageId String
  stage   CrmPipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  /// Deal category (Corporate / Conference) — see CrmDealPipeline. A classifier,
  /// not a second pipeline; nullable so imports/legacy deals need no backfill.
  pipeline CrmDealPipeline?

  /// The org-configurable deal TYPE (business line — "Sponsorship Inquiry",
  /// "Industry Symposium", …). References the admin-editable CrmDealType list;
  /// SetNull so removing a type never blocks or destroys a deal (it just loses its
  /// type). Nullable — legacy/imported deals need no backfill.
  dealTypeId String?
  dealType   CrmDealType? @relation(fields: [dealTypeId], references: [id], onDelete: SetNull)

  /// Free-form tags ("multi-year", "renewal", "warm"), same shape + normalization
  /// as CrmContact.tags / Attendee.tags. Normalized (trim, dedupe, first-casing-
  /// wins) by the deal service, so "Renewal" and "renewal" can't become two tags.
  tags String[] @default([])

  ownerId String?
  owner   User?   @relation("CrmDealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  expectedClose DateTime?
  status        CrmDealStatus @default(OPEN)
  wonAt         DateTime?
  lostAt        DateTime?
  lostReason    String?

  /// Set once the won deal has been pushed to Event.settings.sponsors[] (§7.6),
  /// so the "create sponsor entry" button is offered exactly once.
  sponsorSyncedAt DateTime?

  tasks        CrmTask[]
  notes        CrmNote[]
  products     CrmDealProduct[]
  documents    CrmDealDocument[]
  emailThreads CrmEmailThread[]

  /// External-system provenance (Freshsales CSV import). `externalId` is the
  /// source system's record id — the upsert key that makes RE-importing a fresh
  /// export converge instead of duplicate. `lastImportedAt` powers the conflict
  /// rule: a row edited in EA-SYS after its last import wins over the CSV.
  externalSource String?
  externalId     String?
  lastImportedAt DateTime?

  /// Soft delete — see CrmCompany.archivedAt. Archived deals drop out of the board,
  /// the reports and the CSV export (pipeline totals must not count a dead deal).
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId, status])
  @@index([organizationId, stageId])
  @@index([eventId])
  @@index([companyId])
  @@index([ownerId, status])
}

model CrmTask {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?   @db.Text
  dueAt       DateTime?

  ownerId String?
  owner   User?   @relation("CrmTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  crmContactId String?
  crmContact   CrmContact? @relation(fields: [crmContactId], references: [id], onDelete: Cascade)

  companyId String?
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dealId String?
  deal   CrmDeal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  status CrmTaskStatus @default(OPEN)

  /// Reminder job (worker/jobs/crm-reminders.ts, every 5 min):
  ///   remindAt <= now AND remindedAt IS NULL AND status = OPEN
  /// `remindedAt` is the idempotency stamp — written in the same claim as the
  /// send so a crash mid-tick can't double-email. Served by the plain @@index on
  /// remindAt below (a regular index, not a partial one).
  remindAt   DateTime?
  remindedAt DateTime?

  completedAt DateTime?
  createdById String?

  /// Soft delete — see CrmCompany.archivedAt.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([ownerId, status])
  @@index([dealId])
  @@index([crmContactId])
  @@index([remindAt])
}

/// Manual activity log — the "we actually called them" record that no automated
/// sync can produce. Merges into the existing activity-feed.ts builder so a
/// person's emails + edits + notes render as ONE timeline.
///
/// `authorId` is SetNull: the note body is history and must outlive the author's
/// account. A note attributed to "(deleted user)" is fine; a vanished note isn't.
model CrmNote {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  body         String          @db.Text
  activityType CrmActivityType @default(NOTE)

  authorId String?
  author   User?   @relation("CrmNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  crmContactId String?
  crmContact   CrmContact? @relation(fields: [crmContactId], references: [id], onDelete: Cascade)

  companyId String?
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dealId String?
  deal   CrmDeal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([crmContactId, createdAt])
  @@index([companyId, createdAt])
  @@index([dealId, createdAt])
}

/// Cross-process state for the admin-alert pipeline.
///
/// Dedup used to be an in-memory Map inside admin-alert.ts. With blue-green
/// (two web slots) plus the worker container, that is THREE independent maps —
/// so every error fingerprint could page the operator up to 3x — and each one
/// is wiped on container restart, which means a deploy during an ongoing
/// incident re-opens the floodgates. Postgres gives us one shared, durable,
/// atomically-claimable dedup state.
///
/// Three kinds of row share this table, distinguished by `key`:
///   - "logger:<module>:<msg>"  a single error fingerprint.
///       lastSentAt = when we last emailed about it
///       counter    = occurrences suppressed since that email
///   - "__ceiling__"            the global alerts-per-hour budget.
///       windowStartedAt = start of the current hour bucket
///       counter         = alerts sent inside it
///   - "__silence__"            operator-set maintenance window.
///       silencedUntil = alerts are suppressed until this instant
model AlertState {
  key             String    @id
  lastSentAt      DateTime  @default(now())
  windowStartedAt DateTime  @default(now())
  counter         Int       @default(0)
  silencedUntil   DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Role a person plays ON A SPECIFIC DEAL. The same rep can be PRIMARY on one
/// deal and merely INFLUENCER on another, which is why it lives on the join and
/// not on CrmContact.
enum CrmDealContactRole {
  PRIMARY
  PROCUREMENT
  MARKETING
  TECHNICAL
  INFLUENCER
  OTHER
}

/// A BUSINESS contact — a pharma rep, an exhibitor's sales manager, a society
/// liaison, procurement. The person our team actually negotiates with.
///
/// ─── WHY THIS IS NOT THE `Contact` TABLE ─────────────────────────────────────
/// `Contact` is the EVENT contact store: HCPs — doctors, nurses, allied health.
/// Every row in it is mirrored to the external `contacts_centralv1` table by
/// `contacts-central-sync`, which selects with NO where-clause, and that table
/// feeds `mailchimp_*`. Putting an Abbott sales rep in `Contact` would therefore
/// market to them as if they were a doctor.
///
/// That leak could have been prevented with a discriminator column plus a filter
/// in every reader. It is prevented HERE by structure instead: the central sync
/// reads `Contact`, and a `CrmContact` is not a `Contact`, so a rep CANNOT reach
/// the HCP marketing mirror by someone forgetting a `where` clause. Same
/// reasoning as `nameKey` carrying the unique index rather than trusting every
/// writer to lowercase.
///
/// ─── THE PERSON WHO IS BOTH ──────────────────────────────────────────────────
/// An Abbott rep often also attends the conference (they staff the booth). That
/// person is ONE human with two hats, and EA-SYS's identity rule is "one person,
/// one record" — so we do NOT duplicate them. `contactId` POINTS at their event
/// `Contact` row when one exists. Linked, not copied. Exactly the shape of
/// `Speaker.sourceRegistrationId`.
model CrmContact {
  id             String       @id @default(cuid())
  organizationId String
  org            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The account they work for. Nullable — you often meet the person before you
  /// know which entity is actually signing.
  companyId String?
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String

  /// Display form. `emailKey` (trim+lowercase) carries the unique index — the
  /// same structural dedup as CrmCompany.nameKey, so "S.Khan@abbott.com" and
  /// "s.khan@abbott.com" cannot become two people.
  email    String
  emailKey String

  jobTitle String? // "Regional Medical Affairs Lead"
  phone    String?
  country  String?
  notes    String? @db.Text

  lifecycleStage CrmLifecycleStage?

  /// The rep who OWNS this relationship — powers the "My contacts" filter.
  /// Defaults to the creator (service-level); nullable + SetNull for the same
  /// reason as CrmDeal.ownerId: deleting a user must never block or destroy
  /// the contact, it just becomes unowned. Freshsales-imported rows start
  /// unowned (an import must not hand the whole book to the importer).
  ownerId String?
  owner   User?   @relation("CrmContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Sales-conversation status (NEW → … → WON/LOST). See the enum note for how
  /// this differs from lifecycleStage. Nullable — pre-enrichment rows stay null.
  status CrmContactStatus?

  /// Mobile number, separate from the work `phone` — Freshsales exports carry
  /// both and reps are reached on mobile.
  mobile String?

  /// Free-form tags ("mecomed", "gold-prospect"), same shape as Attendee.tags.
  /// Normalized (trimmed, deduped) by the service.
  tags String[] @default([])

  /// Set ONLY when this business contact is also in the event contact store
  /// (i.e. they attend). SetNull, so deleting the event contact doesn't destroy
  /// the CRM record of the person we're negotiating with.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  deals        CrmDealContact[]
  tasks        CrmTask[]
  crmNotes     CrmNote[]
  emailThreads CrmEmailThread[]

  /// External-system provenance (Freshsales CSV import). `externalId` is the
  /// source system's record id — the upsert key that makes RE-importing a fresh
  /// export converge instead of duplicate. `lastImportedAt` powers the conflict
  /// rule: a row edited in EA-SYS after its last import wins over the CSV.
  externalSource String?
  externalId     String?
  lastImportedAt DateTime?

  /// Soft delete — see CrmCompany.archivedAt.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, emailKey])
  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([ownerId])
}

/// Deal ↔ person, with the role that person plays on THIS deal.
///
/// A sponsorship deal is not negotiated with one human: there is the rep who
/// wants it, the marketing lead who owns the budget, and the procurement officer
/// who can veto it. Modelling that as a single `contactId` on the deal loses the
/// two people who actually decide whether it closes.
model CrmDealContact {
  id String @id @default(cuid())

  // Multi-tenant prep — see the CrmDealProduct.organizationId comment (same
  // rationale: cheap RLS predicate; nullable for blue-green, always app-written).
  organizationId String?

  dealId String
  deal   CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  crmContactId String
  crmContact   CrmContact @relation(fields: [crmContactId], references: [id], onDelete: Cascade)

  role CrmDealContactRole @default(PRIMARY)

  createdAt DateTime @default(now())

  @@unique([dealId, crmContactId])
  @@index([crmContactId])
  @@index([organizationId])
}

// ── Travel Grant (Aug 25, 2026) ────────────────────────────────────────────
// An abstract author based OUTSIDE the UAE is offered a travel grant. The
// offer rides as a block inside the abstract-submission confirmation email
// (D3) and lands on a token-gated consent form, where the author confirms they
// are not a UAE resident and wish to be considered. A UAE-based author sees
// nothing at all: no email block, no link, no row.
//
// Plan + the eight locked decisions: docs/TRAVEL_GRANT_PLAN.md.
//
// Deliberately NOT a financial record. It captures eligibility and interest
// only (D1). Amounts, flights, passports and bank details belong to
// SpeakerReimbursement, and duplicating any of them here would create two
// places to look for the same person's money.
model TravelGrant {
  id             String            @id @default(cuid())
  eventId        String
  /// Multi-tenancy: denormalized tenant key (nullable, no FK), stamped from
  /// the Event at create. Backs prisma/rls/travelgrant.sql (platform-only).
  organizationId String?
  /// D2: one grant per person per event. Enforced by a GLOBAL unique here
  /// rather than a composite on (eventId, speakerId), because Speaker is
  /// itself event-scoped (@@unique([eventId, email])), so one Speaker row IS
  /// one person at one event. A composite would add a second index that can
  /// never bind differently. Same shape as SpeakerReimbursement.speakerId.
  /// Consequence under RLS: a cross-tenant findUnique({ speakerId }) must miss.
  speakerId      String            @unique
  /// Plaintext and GLOBALLY unique, like SpeakerReimbursement.token, because
  /// the organizer copies the link out of the console. Consequence under RLS:
  /// the public route MUST resolve the org from the Event by host+slug BEFORE
  /// this findUnique, or every link fail-closes to "invalid".
  token          String            @unique
  status         TravelGrantStatus @default(PENDING)

  /// Snapshotted at consent, never re-derived. Speaker.country and the terms
  /// text are both editable afterwards, and a later edit must not rewrite what
  /// somebody signed. Same rule as Speaker.agreementTextSnapshot.
  countryAtConsent String?
  fullName         String?
  institution      String?
  termsSnapshot    String? @db.Text

  /// Typed-name e-signature, matching the speaker-agreement acceptance trail.
  signedName  String?
  submittedAt DateTime?
  submittedIp String?

  /// When the link was last put in front of this author. Distinct from
  /// createdAt because the console can re-send.
  invitedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  /// An author with three abstracts gets one link and one consent (D2): the
  /// grant follows the traveller, and a person only travels once. See the
  /// speakerId comment above for where that is actually enforced.
  @@index([eventId, status])
  @@index([organizationId])
}

enum TravelGrantStatus {
  /// Invited. The link has been sent; the author has not submitted the form.
  PENDING
  /// Confirmed they are not a UAE resident and wish to be considered.
  CONSENTED
  /// Opened the form and declined. Recorded so the organizer stops chasing,
  /// and so the email block does not re-ask on their next abstract.
  DECLINED
}

/// A DTCM compliance code the organiser holds but has not handed to anyone yet.
///
/// WHY A TABLE. `Registration.dtcmBarcode` can only hold a code that already
/// belongs to somebody. DTCM issues a BLOCK of codes a day or two before the
/// event, and the ones left over after the pre-event CSV import are what the
/// desk hands to walk-ups on the day. A spare has no registration to hang on,
/// so it needs somewhere to live.
///
/// WHAT THIS IS NOT: it is not the record of who holds which code. That stays
/// `Registration.dtcmBarcode`, which is what the badge renders and what the
/// door scans. A pool row says only "we were issued this code".
///
/// AVAILABILITY IS DERIVED, NEVER STORED. A code is spare iff no registration
/// on this event holds it. There is deliberately no `assignedRegistrationId`
/// column: a second copy of "who has this" would drift the moment somebody
/// typed a code into the detail sheet or re-ran the CSV import, and a pool
/// that believes a code is spare when an attendee is already wearing it hands
/// the same compliance credential to two people. One source of truth costs a
/// second query and cannot be wrong.
model DtcmCode {
  id             String   @id @default(cuid())
  eventId        String
  /// Multi-tenancy: denormalized tenant key (nullable, no FK), stamped from
  /// the Event at create. Backs prisma/rls/dtcmcode.sql (platform-only).
  organizationId String?
  /// The externally-issued value, verbatim. NOT globally unique here: global
  /// uniqueness lives on `Registration.dtcmBarcode`, which is what actually
  /// grants entry. Two events legitimately hold the same code in their pools
  /// if the organiser imports one block twice; only one can ever assign it,
  /// and the assign path surfaces that rather than the import.
  code           String
  importedAt     DateTime @default(now())
  importedById   String?
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@index([eventId])
  @@index([organizationId])
}

// =============================================================================
// HR MODULE (attendance + UAE leave tracker). Plan of record: docs/HR_MODULE_PLAN.md
//
// AVAILABILITY vs TENANCY, and they are different things (owner, Aug 27 2026):
//   * AVAILABILITY is MASTER-SILO ONLY. The module is gated behind
//     HR_MODULE_ENABLED (src/hr/lib/hr-enabled.ts), unset everywhere except
//     master, so platform tenants never see it. Fails CLOSED.
//   * TENANCY is nonetheless first-class. Every table carries organizationId,
//     every write stamps it, and prisma/rls/*.sql policies exist from day one,
//     so switching the module on for a tenant later is a flag, not a rewrite.
// The one thing that must never happen is a master-only feature acquiring
// master-only DATA SHAPE, because that is the part a flag cannot undo.
// =============================================================================

enum EmployeeStatus {
  ACTIVE
  RESIGNED
  TERMINATED
}

/// What a leave code counts as, for the balance engine. The CODE is the
/// organizer-facing label ("AL-HD"); the CATEGORY is what the maths keys on, so
/// an org can rename or add codes without the balance rules following them.
enum LeaveCategory {
  ANNUAL
  SICK_FULL
  SICK_HALF
  SICK_UNPAID
  MATERNITY
  PARENTAL
  BEREAVEMENT
  HAJJ
  STUDY
  NATIONAL_SERVICE
  UNPAID
  ABSENT
  WORK
  REST
  PUBLIC_HOLIDAY
  ON_DUTY
  COMP_OFF
}

model Employee {
  id             String         @id @default(cuid())
  organizationId String
  empCode        String
  name           String
  department     String?
  jobTitle       String?
  /// Calendar date, no time component. See docs/HR_MODULE_PLAN.md §4.1: a leave
  /// day is a date, not an instant, and giving it a time invites a timezone to
  /// change which day it is.
  joiningDate    DateTime       @db.Date
  /// Last working day, INCLUSIVE. Null while employed.
  exitDate       DateTime?      @db.Date
  status         EmployeeStatus @default(ACTIVE)
  /// Annual-leave days carried in from the previous calendar year. Manual for
  /// the one-time seed of the year before go-live, written by the year-end roll
  /// thereafter. CAPPED at +30 (HR_CARRYOVER_CAP_DAYS); a NEGATIVE value is
  /// carried in full and never floored, because a cap on a debt would forgive
  /// it (owner, Aug 27 2026).
  carryoverDays  Decimal        @default(0) @db.Decimal(5, 1)
  /// Agreed annual entitlement for this person, overriding the standard rule.
  /// NULL means "use the rule": 30 days once the first year is complete, 0
  /// before it. Set by hand when a figure is agreed between the employee and
  /// management — typically for a leaver, whose final year is negotiated rather
  /// than calculated (owner ruling, Aug 31 2026). It deliberately BEATS the
  /// first-year gate too: an explicit human decision outranks a rule.
  annualEntitlementDays Decimal? @db.Decimal(5, 1)
  /// Sick days already consumed in the current leave year before go-live,
  /// mirroring the workbook's "Opening Sick Leave Used" column.
  openingSickUsed Decimal       @default(0) @db.Decimal(5, 1)
  /// Comp-off days already earned before go-live.
  openingCompOff  Decimal       @default(0) @db.Decimal(5, 1)
  /// The leave year `carryoverDays` and `openingSickUsed` belong to: the year
  /// this record was created (2026 for the workbook import). They count in
  /// THAT year only; every later year reads its carry-in from `LeaveGrant`,
  /// written by the year-end roll. Without this the seeds applied to every
  /// year forever, so 1 January would silently reset every balance to the
  /// go-live figures (review H6, Aug 31 2026). Null only on a row created by a
  /// path that forgot to set it, and treated as "applies to the year asked
  /// for" so a typed figure is never silently ignored.
  seedLeaveYear   Int?
  /// Link to the core User this employee signs in as, when they have one.
  /// Used from day one: the person who records attendance (Muthu) is himself an
  /// employee, so his entries are self-entries and the audit trail is what makes
  /// that visible. Optional on purpose: an employee who never signs in is still
  /// an employee, and most never will.
  userId         String?        @unique
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?             @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  attendance   AttendanceEntry[]
  grants       LeaveGrant[]
  rules        AttendanceRule[]

  @@unique([organizationId, empCode])
  @@index([organizationId])
  @@index([organizationId, status])
}

model LeaveCode {
  id             String        @id @default(cuid())
  organizationId String
  /// "AL", "AL-HD", "SL-F"... NOTE the naming trap this module lives with:
  /// "-HD" means half DAY, "SL-H" means half PAY (Art. 31 tier 2). They differ
  /// by one character and mean different things. Neither may be abbreviated
  /// further anywhere in the UI.
  code           String
  label          String
  lawReference   String?
  paid           Boolean
  /// 1.0 or 0.5. Decimal, never Float: a float sum of thirty 0.5s is not 15.
  dayWeight      Decimal       @db.Decimal(2, 1)
  countsAs       LeaveCategory
  sortOrder      Int           @default(0)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      AttendanceEntry[]
  rules        AttendanceRule[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// ONE row per (employee, date) that CARRIES INFORMATION. An ordinary working
/// day has NO row: the effective status is derived (weekend -> OFF, public
/// holiday -> PH, otherwise P). The workbook pre-generates all 9,125 rows of
/// which only 943 say anything (docs/HR_MODULE_PLAN.md §3.4); storing the 943
/// is what removes the phantom-row and pre-fill-cleanup class of bug.
model AttendanceEntry {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime @db.Date
  leaveCodeId    String
  remarks        String?
  /// Core User who approved. Deliberately NOT a place for medical detail;
  /// see docs/HR_MODULE_PLAN.md §10.
  approvedById   String?
  /// "ui" | "mcp" | "import" | "cron"
  source         String   @default("ui")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveCode    LeaveCode    @relation(fields: [leaveCodeId], references: [id])

  @@unique([organizationId, employeeId, date])
  @@index([organizationId])
  @@index([employeeId, date])
  @@index([organizationId, date])
}

/// The annual-leave entitlement for ONE employee in ONE leave year, materialised
/// rather than computed. The workbook has no equivalent because it only ever
/// holds a single year; we need one because the year-end roll writes a figure
/// derived from a whole year of entries, and a derived number that later
/// disagrees with the entries it came from is unanswerable.
model LeaveGrant {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  /// Calendar year. The leave year is the CALENDAR year, not the service year
  /// (docs/HR_MODULE_PLAN.md §3.1, read from the workbook's own formulas).
  leaveYear      Int
  /// 30, or 0 for an employee who has not completed twelve months.
  entitlementDays Decimal @db.Decimal(4, 1)
  /// Carried in from the previous year, already capped.
  carriedInDays  Decimal  @db.Decimal(5, 1) @default(0)
  grantedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, leaveYear])
  @@index([organizationId])
  @@index([employeeId])
}

/// Islamic dates move with the moon, so these are entered by HR annually and
/// never generated. A generated guess would be wrong in a way that silently
/// shifts a payroll month.
model PublicHoliday {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @db.Date
  label          String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
}

/// Who a rule speaks for. ORG is every employed person; EMPLOYEE is one person.
/// EMPLOYEE deliberately beats ORG when both apply, because the narrower
/// statement is the more specific one.
enum AttendanceRuleScope {
  ORG
  EMPLOYEE
}

/// A STANDING STATEMENT that derives attendance, instead of one row per person
/// per day.
///
/// This table exists because of a measurement, not a hunch. Of the 386
/// work-from-home days imported from the workbook, 252 are TWELVE company-wide
/// dates on which 20 to 22 people were all remote together (Ramadan and the week
/// after Eid), and a further 120 belong to one permanently remote employee. Only
/// 14 days across five people are genuinely one-offs. So 386 stored rows were
/// holding 27 facts, and the other 359 existed only because the schema had no
/// way to say "the company" or "always".
///
/// A rule NEVER overrides an explicit AttendanceEntry, and never fires on a
/// weekend or a public holiday. Precedence lives in ONE place,
/// `src/hr/lib/hr-effective-status.ts`, so the grid and the balance engine
/// cannot disagree about what a given day means.
///
/// DELIBERATELY NOT HERE: a weekday filter ("every Friday"). The imported data
/// does not support it — individual non-company WFH is spread evenly across all
/// five weekdays — and a contiguous range covers every real case in the file. It
/// is an additive column if that ever stops being true.
model AttendanceRule {
  id             String              @id @default(cuid())
  organizationId String
  scope          AttendanceRuleScope
  /// Set when scope is EMPLOYEE, null when ORG. Enforced in the service, not by
  /// the database, because a conditional NOT NULL is not expressible here.
  employeeId     String?
  leaveCodeId    String
  /// Inclusive.
  startDate      DateTime            @db.Date
  /// Inclusive. NULL means open-ended, which is what a standing arrangement
  /// ("works remotely") is: it holds until somebody ends it.
  endDate        DateTime?           @db.Date
  /// Why this rule exists, in the organiser's own words. Rendered next to it,
  /// so a rule found a year later can still be understood.
  label          String
  /// Core User who created it. A bare scalar with no FK, matching
  /// AttendanceEntry.approvedById: deleting a leaver's login must not cascade
  /// into the attendance record.
  createdById    String?
  /// "ui" | "mcp" | "import" | "cron"
  source         String              @default("ui")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveCode    LeaveCode    @relation(fields: [leaveCodeId], references: [id])

  @@index([organizationId])
  @@index([organizationId, startDate])
  @@index([employeeId])
}
