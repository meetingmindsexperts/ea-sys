// =============================================================================
// HR MODULE (attendance + UAE leave tracker). Plan of record: docs/HR_MODULE_PLAN.md
//
// AVAILABILITY vs TENANCY, and they are different things (owner, Aug 27 2026):
//   * AVAILABILITY is MASTER-SILO ONLY. The module is gated behind
//     HR_MODULE_ENABLED (src/hr/lib/hr-enabled.ts), unset everywhere except
//     master, so platform tenants never see it. Fails CLOSED.
//   * TENANCY is nonetheless first-class. Every table carries organizationId,
//     every write stamps it, and prisma/rls/*.sql policies exist from day one,
//     so switching the module on for a tenant later is a flag, not a rewrite.
// The one thing that must never happen is a master-only feature acquiring
// master-only DATA SHAPE, because that is the part a flag cannot undo.
// =============================================================================

enum EmployeeStatus {
  ACTIVE
  RESIGNED
  TERMINATED
}

/// What a leave code counts as, for the balance engine. The CODE is the
/// organizer-facing label ("AL-HD"); the CATEGORY is what the maths keys on, so
/// an org can rename or add codes without the balance rules following them.
enum LeaveCategory {
  ANNUAL
  SICK_FULL
  SICK_HALF
  SICK_UNPAID
  MATERNITY
  PARENTAL
  BEREAVEMENT
  HAJJ
  STUDY
  NATIONAL_SERVICE
  UNPAID
  ABSENT
  WORK
  REST
  PUBLIC_HOLIDAY
  ON_DUTY
  COMP_OFF
}

model Employee {
  id                    String         @id @default(cuid())
  organizationId        String
  empCode               String
  name                  String
  department            String?
  jobTitle              String?
  /// Calendar date, no time component. See docs/HR_MODULE_PLAN.md §4.1: a leave
  /// day is a date, not an instant, and giving it a time invites a timezone to
  /// change which day it is.
  joiningDate           DateTime       @db.Date
  /// Last working day, INCLUSIVE. Null while employed.
  exitDate              DateTime?      @db.Date
  status                EmployeeStatus @default(ACTIVE)
  /// Annual-leave days carried in from the previous calendar year. Manual for
  /// the one-time seed of the year before go-live, written by the year-end roll
  /// thereafter. CAPPED at +30 (HR_CARRYOVER_CAP_DAYS); a NEGATIVE value is
  /// carried in full and never floored, because a cap on a debt would forgive
  /// it (owner, Aug 27 2026).
  carryoverDays         Decimal        @default(0) @db.Decimal(5, 1)
  /// Agreed annual entitlement for this person, overriding the standard rule.
  /// NULL means "use the rule": 30 days once the first year is complete, 0
  /// before it. Set by hand when a figure is agreed between the employee and
  /// management — typically for a leaver, whose final year is negotiated rather
  /// than calculated (owner ruling, Aug 31 2026). It deliberately BEATS the
  /// first-year gate too: an explicit human decision outranks a rule.
  annualEntitlementDays Decimal?       @db.Decimal(5, 1)
  /// Sick days already consumed in the current leave year before go-live,
  /// mirroring the workbook's "Opening Sick Leave Used" column.
  openingSickUsed       Decimal        @default(0) @db.Decimal(5, 1)
  /// Comp-off days already earned before go-live.
  openingCompOff        Decimal        @default(0) @db.Decimal(5, 1)
  /// The leave year `carryoverDays` and `openingSickUsed` belong to: the year
  /// this record was created (2026 for the workbook import). They count in
  /// THAT year only; every later year reads its carry-in from `LeaveGrant`,
  /// written by the year-end roll. Without this the seeds applied to every
  /// year forever, so 1 January would silently reset every balance to the
  /// go-live figures (review H6, Aug 31 2026). Null only on a row created by a
  /// path that forgot to set it, and treated as "applies to the year asked
  /// for" so a typed figure is never silently ignored.
  seedLeaveYear         Int?
  /// Link to the core User this employee signs in as, when they have one.
  /// Used from day one: the person who records attendance (Muthu) is himself an
  /// employee, so his entries are self-entries and the audit trail is what makes
  /// that visible. Optional on purpose: an employee who never signs in is still
  /// an employee, and most never will.
  userId                String?        @unique
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?             @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  attendance   AttendanceEntry[]
  grants       LeaveGrant[]
  rules        AttendanceRule[]

  @@unique([organizationId, empCode])
  @@index([organizationId])
  @@index([organizationId, status])
}

model LeaveCode {
  id             String        @id @default(cuid())
  organizationId String
  /// "AL", "AL-HD", "SL-F"... NOTE the naming trap this module lives with:
  /// "-HD" means half DAY, "SL-H" means half PAY (Art. 31 tier 2). They differ
  /// by one character and mean different things. Neither may be abbreviated
  /// further anywhere in the UI.
  code           String
  label          String
  lawReference   String?
  paid           Boolean
  /// 1.0 or 0.5. Decimal, never Float: a float sum of thirty 0.5s is not 15.
  dayWeight      Decimal       @db.Decimal(2, 1)
  countsAs       LeaveCategory
  sortOrder      Int           @default(0)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      AttendanceEntry[]
  rules        AttendanceRule[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// ONE row per (employee, date) that CARRIES INFORMATION. An ordinary working
/// day has NO row: the effective status is derived (weekend -> OFF, public
/// holiday -> PH, otherwise P). The workbook pre-generates all 9,125 rows of
/// which only 943 say anything (docs/HR_MODULE_PLAN.md §3.4); storing the 943
/// is what removes the phantom-row and pre-fill-cleanup class of bug.
model AttendanceEntry {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime @db.Date
  leaveCodeId    String
  remarks        String?
  /// Core User who approved. Deliberately NOT a place for medical detail;
  /// see docs/HR_MODULE_PLAN.md §10.
  approvedById   String?
  /// "ui" | "mcp" | "import" | "cron"
  source         String   @default("ui")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveCode    LeaveCode    @relation(fields: [leaveCodeId], references: [id])

  @@unique([organizationId, employeeId, date])
  @@index([organizationId])
  @@index([employeeId, date])
  @@index([organizationId, date])
}

/// The annual-leave entitlement for ONE employee in ONE leave year, materialised
/// rather than computed. The workbook has no equivalent because it only ever
/// holds a single year; we need one because the year-end roll writes a figure
/// derived from a whole year of entries, and a derived number that later
/// disagrees with the entries it came from is unanswerable.
model LeaveGrant {
  id              String   @id @default(cuid())
  organizationId  String
  employeeId      String
  /// Calendar year. The leave year is the CALENDAR year, not the service year
  /// (docs/HR_MODULE_PLAN.md §3.1, read from the workbook's own formulas).
  leaveYear       Int
  /// 30, or 0 for an employee who has not completed twelve months.
  entitlementDays Decimal  @db.Decimal(4, 1)
  /// Carried in from the previous year, already capped.
  carriedInDays   Decimal  @default(0) @db.Decimal(5, 1)
  grantedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, leaveYear])
  @@index([organizationId])
  @@index([employeeId])
}

/// Islamic dates move with the moon, so these are entered by HR annually and
/// never generated. A generated guess would be wrong in a way that silently
/// shifts a payroll month.
model PublicHoliday {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @db.Date
  label          String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
}

/// Who a rule speaks for. ORG is every employed person; EMPLOYEE is one person.
/// EMPLOYEE deliberately beats ORG when both apply, because the narrower
/// statement is the more specific one.
enum AttendanceRuleScope {
  ORG
  EMPLOYEE
}

/// A STANDING STATEMENT that derives attendance, instead of one row per person
/// per day.
///
/// This table exists because of a measurement, not a hunch. Of the 386
/// work-from-home days imported from the workbook, 252 are TWELVE company-wide
/// dates on which 20 to 22 people were all remote together (Ramadan and the week
/// after Eid), and a further 120 belong to one permanently remote employee. Only
/// 14 days across five people are genuinely one-offs. So 386 stored rows were
/// holding 27 facts, and the other 359 existed only because the schema had no
/// way to say "the company" or "always".
///
/// A rule NEVER overrides an explicit AttendanceEntry, and never fires on a
/// weekend or a public holiday. Precedence lives in ONE place,
/// `src/hr/lib/hr-effective-status.ts`, so the grid and the balance engine
/// cannot disagree about what a given day means.
///
/// DELIBERATELY NOT HERE: a weekday filter ("every Friday"). The imported data
/// does not support it — individual non-company WFH is spread evenly across all
/// five weekdays — and a contiguous range covers every real case in the file. It
/// is an additive column if that ever stops being true.
model AttendanceRule {
  id             String              @id @default(cuid())
  organizationId String
  scope          AttendanceRuleScope
  /// Set when scope is EMPLOYEE, null when ORG. Enforced in the service, not by
  /// the database, because a conditional NOT NULL is not expressible here.
  employeeId     String?
  leaveCodeId    String
  /// Inclusive.
  startDate      DateTime            @db.Date
  /// Inclusive. NULL means open-ended, which is what a standing arrangement
  /// ("works remotely") is: it holds until somebody ends it.
  endDate        DateTime?           @db.Date
  /// Why this rule exists, in the organiser's own words. Rendered next to it,
  /// so a rule found a year later can still be understood.
  label          String
  /// Core User who created it. A bare scalar with no FK, matching
  /// AttendanceEntry.approvedById: deleting a leaver's login must not cascade
  /// into the attendance record.
  createdById    String?
  /// "ui" | "mcp" | "import" | "cron"
  source         String              @default("ui")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveCode    LeaveCode    @relation(fields: [leaveCodeId], references: [id])

  @@index([organizationId])
  @@index([organizationId, startDate])
  @@index([employeeId])
}

