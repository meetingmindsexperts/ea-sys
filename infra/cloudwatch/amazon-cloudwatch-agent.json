{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "aggregation_dimensions": [
      [
        "InstanceId"
      ]
    ],
    "metrics_collected": {
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "drop_device": true,
        "metrics_collection_interval": 60
      },
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/home/ubuntu/ea-sys/logs/app.log",
            "log_group_name": "ea-sys/app",
            "log_stream_name": "mumbai-{instance_id}",
            "retention_in_days": 30,
            "timestamp_format": "%Y-%m-%dT%H:%M:%S",
            "timezone": "UTC"
          },
          {
            "file_path": "/home/ubuntu/ea-sys/logs/mediamtx.log",
            "log_group_name": "ea-sys/mediamtx",
            "log_stream_name": "mumbai-{instance_id}",
            "retention_in_days": 30,
            "timestamp_format": "%Y/%m/%d %H:%M:%S",
            "timezone": "UTC"
          },
          {
            "file_path": "/home/ubuntu/ea-sys/logs/error.log",
            "log_group_name": "ea-sys/error",
            "log_stream_name": "mumbai-{instance_id}",
            "retention_in_days": 90,
            "timestamp_format": "%Y-%m-%dT%H:%M:%S",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/lib/docker/containers/*/*-json.log",
            "log_group_name": "ea-sys/docker",
            "log_stream_name": "mumbai-{instance_id}",
            "retention_in_days": 30,
            "filters": [
              {
                "type": "include",
                "expression": "\"ea_sys_service\":\""
              },
              {
                "type": "exclude",
                "expression": "level\\\\\":(10|20|30)[,}]"
              }
            ],
            "publish_multi_logs": true
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "ea-sys/nginx-error",
            "log_stream_name": "mumbai-{instance_id}",
            "retention_in_days": 30,
            "timestamp_format": "%Y/%m/%d %H:%M:%S",
            "timezone": "UTC"
          }
        ]
      }
    },
    "log_stream_name": "mumbai-fallback",
    "force_flush_interval": 5
  }
}
