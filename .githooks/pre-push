#!/bin/bash
# A push to main is a production deploy. This hook refuses one while a deploy
# is already running. It binds everyone who pushes from this checkout: every
# agent session and the owner.
#
# IT NO LONGER REFUSES A TIP THAT HAS NOT PASSED THE GATE (owner, Nov 24, 2026:
# "disable the gate to push, from now on I will manually ask to gate and push").
# From Nov 17 to Nov 24, 2026 it did. Now an ungated tip is pushed, and the hook
# says so and writes it down in <git dir>/gate/ungated-pushes.log, so a red CI
# run can be traced to a push nobody gated. When the gate runs is the owner's
# call (AGENTS.md rule 5): CI is then the only check before the deploy, and the
# browser suite with its route smoke test runs nowhere but in the gate.
#
# OWNER OVERRIDE of the running-deploy check, recorded in <git dir>/gate/overrides.log:
#   GATE_OVERRIDE=1 git push origin <sha>:main
# Agents may not set it: scripts/agent-command-guard.mjs refuses the command.
#
# Git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
# shellcheck source=scripts/gate-stamp.sh
. "$REPO/scripts/gate-stamp.sh" 2>/dev/null || { echo "pre-push: scripts/gate-stamp.sh is missing; the gate check is skipped"; exit 0; }

ZERO=0000000000000000000000000000000000000000
DIR=$(gate_stamp_dir)
REFUSED=0

override() {
  mkdir -p "$DIR"
  printf '%s override %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" >> "$DIR/overrides.log"
  echo "pre-push: GATE_OVERRIDE is set: $2 skipped for $(printf '%s' "$1" | cut -c1-8). Recorded."
}

# A deploy already running, queued or waiting for main? Fails OPEN when gh
# cannot answer: this check only avoids overlapping deploys. gh is given 10 seconds and then killed (it is a
# Go program and ignores the alarm signal a `perl -e alarm` wrapper would send).
deploy_running() {
  [ "${GATE_NO_CI_CHECK:-}" = "1" ] && return 1
  command -v gh >/dev/null 2>&1 || return 1
  local out pid killer rc active base
  base="${TMPDIR:-/tmp}"
  out=$(mktemp "${base%/}/ea-sys-prepush.XXXXXX") || return 1
  gh run list --workflow deploy.yml --branch main --limit 5 --json status \
    --jq '[.[] | select(.status == "in_progress" or .status == "queued" or .status == "waiting" or .status == "pending" or .status == "requested")] | length' \
    > "$out" 2>/dev/null < /dev/null &
  pid=$!
  (sleep 10; kill -9 "$pid" 2>/dev/null) > /dev/null 2>&1 &
  killer=$!
  wait "$pid" 2>/dev/null
  rc=$?
  kill "$killer" 2>/dev/null
  wait "$killer" 2>/dev/null # reaped here, quietly: otherwise bash prints "Terminated: 15" into the push output
  active=$(cat "$out" 2>/dev/null)
  rm -f "$out"
  [ "$rc" = "0" ] && [ -n "$active" ] && [ "$active" != "0" ]
}

while read -r local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue
  short=$(printf '%s' "$local_sha" | cut -c1-8)

  # Said and written down, never refused (see the header).
  if [ ! -f "$(gate_stamp_file "$local_sha")" ]; then
    mkdir -p "$DIR"
    printf '%s ungated %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$local_sha" >> "$DIR/ungated-pushes.log"
    echo "pre-push: $short has not passed the gate (npm run gate -- $short, about 3 minutes). Pushing anyway: CI is the only check. Recorded."
  fi

  if deploy_running; then
    if [ "${GATE_OVERRIDE:-}" = "1" ]; then
      override "$local_sha" "the running-deploy check"
    else
      echo ""
      echo "PUSH REFUSED: a deploy of main is running or queued on GitHub."
      echo "  Wait for it (gh run list --workflow deploy.yml), then push again."
      echo "  Owner:  GATE_OVERRIDE=1 git push ...   pushes anyway."
      echo ""
      REFUSED=1
    fi
  fi
done

exit $REFUSED
